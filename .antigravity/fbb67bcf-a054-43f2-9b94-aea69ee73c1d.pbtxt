  file_change {
    absolute_path_uri: "file:///components/Navbar.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "\"use client\";\n\nimport { useState } from \"react\";\nimport Link from \"next/link\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport { Menu, X, Phone } from \"lucide-react\";\n\nexport function Navbar() {\n  const [isOpen, setIsOpen] = useState(false);\n\n  const links = [\n    { name: \"Home\", href: \"/\" },\n    { name: \"Services\", href: \"/services\" },\n    { name: \"About Us\", href: \"/about\" },\n    { name: \"Contact\", href: \"/contact\" },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-100\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-24 flex items-center justify-between\">\n        {/* Brand Logo */}\n        <Link href=\"/\" className=\"flex flex-col items-center justify-center leading-none\">\n          <span className=\"font-serif text-brand-teal text-4xl tracking-tight\">RIVO</span>\n          <div className=\"w-full h-px bg-brand-navy my-0.5 relative\">\n             <div className=\"absolute top-0 right-0 w-8 h-1 bg-brand-navy rounded-full -mt-[1.5px]\"></div>\n          </div>\n          <span className=\"font-sans text-brand-navy tracking-[0.3em] text-[10px] font-semibold\">LENDING</span>\n        </Link>\n\n        {/* Desktop Nav */}\n        <nav className=\"hidden md:flex items-center gap-8\">\n          {links.map((link) => (\n            <Link key={link.name} href={link.href} className=\"text-sm font-semibold text-brand-navy hover:text-brand-teal transition-colors\">\n              {link.name}\n            </Link>\n          ))}\n          <Link href=\"/contact\" className=\"ml-4 px-6 py-2.5 bg-brand-teal text-white text-sm font-semibold rounded hover:bg-brand-teal/90 transition-all flex items-center gap-2 shadow-sm\">\n            <Phone className=\"w-4 h-4\" /> Get an Assessment\n          </Link>\n        </nav>\n\n        {/* Mobile Menu Button */}\n        <button \n          className=\"md:hidden p-2 text-brand-navy\"\n          onClick={() => setIsOpen(!isOpen)}\n        >\n          {isOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n        </button>\n      </div>\n\n      {/* Mobile Nav */}\n      <AnimatePresence>\n        {isOpen && (\n          <motion.div \n            initial={{ opacity: 0, height: 0 }}\n            animate={{ opacity: 1, height: \"auto\" }}\n            exit={{ opacity: 0, height: 0 }}\n            className=\"md:hidden bg-white border-b border-slate-100 overflow-hidden\"\n          >\n            <nav className=\"flex flex-col p-4 gap-4\">\n              {links.map((link) => (\n                <Link \n                  key={link.name} \n                  href={link.href} \n                  className=\"text-base font-medium text-brand-navy py-2 px-4 hover:bg-slate-50 rounded-md\"\n                  onClick={() => setIsOpen(false)}\n                >\n                  {link.name}\n                </Link>\n              ))}\n              <Link \n                href=\"/contact\" \n                className=\"w-full text-center px-5 py-3 bg-brand-teal text-white font-semibold rounded-md mt-2 flex justify-center items-center gap-2\"\n                onClick={() => setIsOpen(false)}\n              >\n                <Phone className=\"w-4 h-4\" /> Get an Assessment\n              </Link>\n            </nav>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </header>\n  );\n}"
    }
