      replacement_content: "\"use client\";\n\nimport { useState, useEffect } from \"react\";\nimport Link from \"next/link\";\nimport { motion, AnimatePresence } from \"motion/react\";\nimport { Menu, X, Phone } from \"lucide-react\";\n\nexport function Navbar() {\n  const [isOpen, setIsOpen] = useState(false);\n  const [isScrolled, setIsScrolled] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      setIsScrolled(window.scrollY > 20);\n    };\n    window.addEventListener(\"scroll\", handleScroll);\n    return () => window.removeEventListener(\"scroll\", handleScroll);\n  }, []);\n\n  const links = [\n    { name: \"Home Loans\", href: \"/#home-loans\" },\n    { name: \"Refinance\", href: \"/#refinance\" },\n    { name: \"About\", href: \"/#about\" },\n    { name: \"Resources\", href: \"/#resources\" },\n  ];\n\n  return (\n    <header className={`fixed top-0 w-full z-50 transition-all duration-300 ${isScrolled ? \"bg-white/95 backdrop-blur-md shadow-sm py-4\" : \"bg-transparent py-6\"}`}>\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between\">\n        {/* Abstract Rivo Logo */}\n        <Link href=\"/\" className=\"relative flex items-center gap-2 group z-50\">\n          <div className=\"flex flex-col\">\n            <div className=\"flex items-baseline\">\n              <span className=\"font-serif text-4xl text-brand-teal tracking-tight leading-none\">RIVO</span>\n            </div>\n            {/* Minimal SVG Wave replacing the static line */}\n            <svg width=\"60\" height=\"12\" viewBox=\"0 0 60 12\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" className=\"absolute -bottom-2 -left-1\">\n              <path d=\"M0 6C10 6 15 1 25 1C35 1 45 11 55 11C58 11 60 10 60 10\" stroke=\"#173552\" strokeWidth=\"2.5\" strokeLinecap=\"round\"/>\n              <path d=\"M0 8C12 8 18 3 30 3C42 3 48 11 60 11\" stroke=\"#08B2B0\" strokeWidth=\"2.5\" strokeLinecap=\"round\"/>\n            </svg>\n            <span className=\"font-sans text-brand-navy tracking-[0.3em] text-[8px] font-bold mt-1 ml-1\">LENDING</span>\n          </div>\n        </Link>\n\n        {/* Desktop Nav */}\n        <nav className=\"hidden md:flex items-center gap-8\">\n          {links.map((link) => (\n            <Link key={link.name} href={link.href} className=\"text-sm font-bold text-brand-navy hover:text-brand-teal transition-colors tracking-wide\">\n              {link.name}\n            </Link>\n          ))}\n          <div className=\"flex items-center gap-6 ml-4 pl-8 border-l border-brand-navy/10\">\n            <Link href=\"tel:1300000000\" className=\"text-brand-navy flex items-center gap-2 text-sm font-bold hover:text-brand-teal transition-colors\">\n              <Phone className=\"w-4 h-4\" /> 1300 XXX XXX\n            </Link>\n            <Link href=\"/contact\" className=\"px-6 py-3 bg-brand-teal text-white text-sm font-bold rounded-full hover:bg-brand-teal/90 transition-all shadow-[0_4px_14px_0_rgba(8,178,176,0.39)] hover:shadow-[0_6px_20px_rgba(8,178,176,0.23)] hover:-translate-y-0.5\">\n              Get Started \342\206\222\n            </Link>\n          </div>\n        </nav>\n\n        {/* Mobile Menu Button */}\n        <button \n          className=\"md:hidden p-2 text-brand-navy relative z-50\"\n          onClick={() => setIsOpen(!isOpen)}\n        >\n          {isOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n        </button>\n      </div>\n\n      {/* Mobile Nav */}\n      <AnimatePresence>\n        {isOpen && (\n          <motion.div \n            initial={{ opacity: 0, y: -20 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -20 }}\n            transition={{ duration: 0.2 }}\n            className=\"md:hidden fixed inset-0 top-0 pt-24 bg-white z-40 h-screen overflow-y-auto\"\n          >\n            <nav className=\"flex flex-col p-6 gap-4 max-w-md mx-auto\">\n              {links.map((link) => (\n                <Link \n                  key={link.name} \n                  href={link.href} \n                  className=\"text-xl font-serif text-brand-navy py-3 px-4 hover:bg-brand-soft-teal rounded-xl transition-colors border-b border-slate-50\"\n                  onClick={() => setIsOpen(false)}\n                >\n                  {link.name}\n                </Link>\n              ))}\n              <div className=\"mt-8 space-y-4\">\n                <Link href=\"tel:1300000000\" className=\"py-4 flex items-center justify-center gap-3 text-brand-navy font-bold text-lg bg-slate-50 rounded-2xl\">\n                  <Phone className=\"w-5 h-5 text-brand-teal\" /> 1300 XXX XXX\n                </Link>\n                <Link \n                  href=\"/contact\" \n                  className=\"w-full text-center px-5 py-4 bg-brand-teal text-white font-bold text-lg rounded-2xl flex justify-center items-center shadow-lg\"\n                  onClick={() => setIsOpen(false)}\n                >\n                  Get Started \342\206\222\n                </Link>\n              </div>\n            </nav>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </header>\n  );\n}\n"
    }
