    replacement_chunks {
      target_content: "  const [propertyValue, setPropertyValue] = useState(750000);\n  const [deposit, setDeposit] = useState(150000);\n  \n  const loanAmount = Math.max(0, propertyValue - deposit);\n  const lvr = propertyValue > 0 ? ((loanAmount / propertyValue) * 100).toFixed(1) : \"0.0\";\n  \n  // Generic 6% over 30 years calculation\n  const monthlyRate = 0.06 / 12;\n  const numPayments = 30 * 12;\n  const monthlyRepayment = loanAmount > 0 \n    ? (loanAmount * monthlyRate * Math.pow(1 + monthlyRate, numPayments)) / (Math.pow(1 + monthlyRate, numPayments) - 1)\n    : 0;\n\n  const [openFaq, setOpenFaq] = useState<number | null>(null);\n\n  const formatCurrency = (val: number) => {\n    return new Intl.NumberFormat(\'en-AU\', { style: \'currency\', currency: \'AUD\', maximumFractionDigits: 0 }).format(val);\n  };\n\n  const helpCards = [\n    { title: \"Buy a Home\", desc: \"First home, next home or forever home.\", link: \"Explore Home Loans\", icon: Home },\n    { title: \"Refinance\", desc: \"See whether your current loan is still working for you.\", link: \"Explore Refinancing\", icon: ArrowRight },\n    { title: \"Invest\", desc: \"Build your property portfolio with a loan strategy designed around you.\", link: \"Investment Loans\", icon: Building2 },\n    { title: \"Build & Renovate\", desc: \"Finance your next project with confidence.\", link: \"Construction Loans\", icon: Hammer },\n  ];"
      replacement_content: "  const [openFaq, setOpenFaq] = useState<number | null>(null);\n\n  const helpCards = [\n    { title: \"Buy a Home\", desc: \"A simple path from pre-approval to settlement for your first or next home.\", link: \"Explore Home Loans\", href: \"/services/home-loans\", icon: Home },\n    { title: \"Refinance\", desc: \"See if your current loan is still working for you and structure a better rate.\", link: \"Explore Refinancing\", href: \"/services/refinance\", icon: ArrowRight },\n    { title: \"Invest\", desc: \"Build your property portfolio with a loan strategy designed around your financial goals.\", link: \"Investment Loans\", href: \"/services/investment-loans\", icon: Building2 },\n    { title: \"Build & Renovate\", desc: \"Finance your construction project with confidence and clear draw-down structures.\", link: \"Construction Loans\", href: \"/services/construction-loans\", icon: Hammer },\n  ];"
    }
    replacement_chunks {
      target_content: "            <motion.h1 \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }}\n              className=\"font-serif text-5xl md:text-6xl lg:text-7xl font-normal text-brand-navy leading-[1.1] mb-8\"\n            >\n              Your next move starts with the right loan.\n            </motion.h1>\n            <motion.p \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.2 }}\n              className=\"text-lg text-brand-text-muted mb-10 leading-relaxed font-medium\"\n            >\n              Whether you\'re buying your first home, refinancing, investing or building, RIVO Lending helps you navigate your options and find a loan that fits your goals.\n            </motion.p>\n            \n            {/* Primary CTA Rhythm: Strong hero action */}\n            <motion.div \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}\n              className=\"flex flex-col sm:flex-row items-start sm:items-center gap-6 mb-10\"\n            >\n              <Link href=\"/contact\" className=\"inline-flex items-center justify-center px-8 py-4 bg-brand-teal text-white font-bold rounded-full hover:bg-brand-teal/90 transition-all shadow-[0_4px_14px_0_rgba(8,178,176,0.39)] hover:shadow-[0_6px_20px_rgba(8,178,176,0.23)] hover:-translate-y-0.5\">\n                Book a consultation\n              </Link>\n              <Link href=\"/contact\" className=\"inline-flex items-center text-brand-navy font-bold hover:text-brand-teal transition-colors\">\n                Talk to a Broker <ChevronRight className=\"w-4 h-4 ml-1\" />\n              </Link>\n            </motion.div>"
      replacement_content: "            <motion.h1 \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }}\n              className=\"font-serif text-5xl md:text-6xl lg:text-7xl font-normal text-brand-navy leading-[1.1] mb-8\"\n            >\n              Your priority is finding the right loan. Ours is making it happen.\n            </motion.h1>\n            <motion.p \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.2 }}\n              className=\"text-lg text-brand-text-muted mb-10 leading-relaxed font-medium\"\n            >\n              Whether you\'re buying a property, refinancing an existing loan, or building an investment portfolio, we provide the clarity and structure you need.\n            </motion.p>\n            \n            {/* Primary CTA Rhythm: Strong hero action */}\n            <motion.div \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}\n              className=\"flex flex-col sm:flex-row items-start sm:items-center gap-6 mb-10\"\n            >\n              <Link href=\"/services/home-loans\" className=\"inline-flex items-center justify-center px-8 py-4 bg-brand-teal text-white font-bold rounded-full hover:bg-brand-teal/90 transition-all shadow-[0_4px_14px_0_rgba(8,178,176,0.39)] hover:shadow-[0_6px_20px_rgba(8,178,176,0.23)] hover:-translate-y-0.5\">\n                Buy a Property\n              </Link>\n              <Link href=\"/services/refinance\" className=\"inline-flex items-center text-brand-navy font-bold hover:text-brand-teal transition-colors\">\n                Refinance <ChevronRight className=\"w-4 h-4 ml-1\" />\n              </Link>\n            </motion.div>"
    }
