\"space-y-4 text-white/80 font-medium\">\n              <li><Link href=\"#\" className=\"hover:text-brand-teal transition-colors\">First Home Buyers</Link></li>\n              <li><Link href=\"#\" className=\"hover:text-brand-teal transition-colors\">Home Loans</Link></li>\n              <li><Link href=\"#\" className=\"hover:text-brand-teal transition-colors\">Refinancing</Link></li>\n              <li><Link href=\"#\" className=\"hover:text-brand-teal transition-colors\">Investment Loans</Link></li>\n              <li><Link href=\"#\" className=\"hover:text-brand-teal transition-colors\">Construction</Link></li>\n            </ul>\n          </div>\n          \n          <div className=\"lg:col-span-1\">\n            <h4 className=\"font-bold text-sm tracking-widest text-white/40 uppercase mb-6\">About</h4>\n            <ul className=\"space-y-4 text-white/80 font-medium\">\n              <li><Link href=\"#\" className=\"hover:text-brand-teal transition-colors\">About RIVO</Link></li>\n              <li><Link href=\"#\" className=\"hover:text-brand-teal transition-colors\">Our Brokers</Link></li>\n              <li><Link href=\"#\" className=\"hover:text-brand-teal transition-colors\">Why RIVO</Link></li>\n              <li><Link href=\"#\" className=\"hover:text-brand-teal transition-colors\">Testimonials</Link></li>\n              <li><Link href=\"#\" className=\"hover:text-brand-teal transition-colors\">Careers</Link></li>\n            </ul>\n          </div>\n\n          <div className=\"lg:col-span-1\">\n            <h4 className=\"font-bold text-sm tracking-widest text-white/40 uppercase mb-6\">Resources</h4>\n            <ul className=\"space-y-4 text-white/80 font-medium\">\n              <li><Link href=\"#\" className=\"hover:text-brand-teal transition-colors\">Calculators</Link></li>\n              <li><Link href=\"#\" className=\"hover:text-brand-teal transition-colors\">Guides</Link></li>\n              <li><Link href=\"#\" className=\"hover:text-brand