    replacement_chunks {
      replacement_content: "import Link from \"next/link\";\nimport { Home, Mail, Phone, MapPin } from \"lucide-react\";\n\nexport function Footer() {\n  return (\n    <footer className=\"bg-brand-navy text-white/80 py-16 border-t border-brand-navy\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"grid md:grid-cols-4 gap-12 mb-12\">\n          <div className=\"md:col-span-2\">\n            <Link href=\"/\" className=\"flex flex-col items-start leading-none mb-6\">\n              <span className=\"font-serif text-brand-teal text-4xl tracking-tight\">RIVO</span>\n              <div className=\"w-24 h-px bg-white my-1 relative\"></div>\n              <span className=\"font-sans text-white tracking-[0.3em] text-[10px] font-semibold\">LENDING</span>\n            </Link>\n            <p className=\"text-sm max-w-sm mb-6 leading-relaxed\">\n              Expert mortgage broking tailored for you. Navigate the complex mortgage market with Rivo Lending to secure your financial future.\n            </p>\n            <div className=\"space-y-2 text-sm\">\n              <div className=\"flex items-center gap-3\">\n                <Phone className=\"w-4 h-4 text-brand-teal\" /> 1300 123 456\n              </div>\n              <div className=\"flex items-center gap-3\">\n                <Mail className=\"w-4 h-4 text-brand-teal\" /> support@rivolending.com.au\n              </div>\n            </div>\n          </div>\n          \n          <div>\n            <h4 className=\"text-white font-semibold mb-6\">Navigation</h4>\n            <ul className=\"space-y-3 text-sm\">\n              <li><Link href=\"/\" className=\"hover:text-brand-teal transition-colors\">Home</Link></li>\n              <li><Link href=\"/services\" className=\"hover:text-brand-teal transition-colors\">Services</Link></li>\n              <li><Link href=\"/about\" className=\"hover:text-brand-teal transition-colors\">About Us</Link></li>\n              <li><Link href=\"/contact\" className=\"hover:text-brand-teal transition-colors\">Contact</Link></li>\n            </ul>\n          </div>\n          \n          <div>\n            <h4 className=\"text-white font-semibold mb-6\">Services</h4>\n            <ul className=\"space-y-3 text-sm\">\n              <li><Link href=\"/services\" className=\"hover:text-brand-teal transition-colors\">First Home Buyer</Link></li>\n              <li><Link href=\"/services\" className=\"hover:text-brand-teal transition-colors\">Refinancing</Link></li>\n              <li><Link href=\"/services\" className=\"hover:text-brand-teal transition-colors\">Investment Loans</Link></li>\n              <li><Link href=\"/services\" className=\"hover:text-brand-teal transition-colors\">Commercial Finance</Link></li>\n            </ul>\n          </div>\n        </div>\n        \n        <div className=\"pt-8 border-t border-white/10 text-xs flex flex-col md:flex-row justify-between items-center gap-4 text-white/50\">\n          <p>&copy; {new Date().getFullYear()} Rivo Lending. All rights reserved. Credit Rep No. XXXXXX</p>\n          <div className=\"flex gap-6\">\n            <Link href=\"#\" className=\"hover:text-white transition-colors\">Privacy Policy</Link>\n            <Link href=\"#\" className=\"hover:text-white transition-colors\">Terms of Service</Link>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n}"
    }
