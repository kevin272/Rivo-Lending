    instruction: "Replace the entire page.tsx content with the new architecture."
    replacement_infos {
      original_chunk {
        target_content: "\"use client\";\n\nimport { motion } from \"motion/react\";\nimport Image from \"next/image\";\nimport Link from \"next/link\";\nimport { useState } from \"react\";\nimport { Check, ArrowRight, Home, Building2, Hammer, Plus, Minus, Star, ChevronRight } from \"lucide-react\";\n\nexport default function HomePage() {\n  const [openFaq, setOpenFaq] = useState<number | null>(null);\n\n  const helpCards = [\n    { title: \"Buy a Home\", desc: \"A simple path from pre-approval to settlement for your first or next home.\", link: \"Explore Home Loans\", href: \"/services/home-loans\", icon: Home },\n    { title: \"Refinance\", desc: \"See if your current loan is still working for you and structure a better rate.\", link: \"Explore Refinancing\", href: \"/services/refinance\", icon: ArrowRight },\n    { title: \"Invest\", desc: \"Build your property portfolio with a loan strategy designed around your financial goals.\", link: \"Investment Loans\", href: \"/services/investment-loans\", icon: Building2 },\n    { title: \"Build & Renovate\", desc: \"Finance your construction project with confidence and clear draw-down structures.\", link: \"Construction Loans\", href: \"/services/construction-loans\", icon: Hammer },\n  ];\n\n  const faqs = [\n    { q: \"Can I get a home loan with a small deposit?\", a: \"Yes, there are several options available including First Home Owner Grants, Lenders Mortgage Insurance (LMI), and guarantor loans. We can assess your specific situation and guide you through the best path.\" },\n    { q: \"How much can I borrow?\", a: \"Your borrowing capacity depends on your income, expenses, existing debts, and the size of your deposit. Use our calculator for an estimate, or speak to one of our brokers for an accurate assessment based on current lender policies.\" },\n    { q: \"Will applying affect my credit score?\", a: \"Having a preliminary conversation with us will not affect your credit score. We only submit a formal application once you are completely satisfied with the chosen loan product.\" },\n  ];\n\n  return (\n    <div className=\"flex flex-col font-sans overflow-x-hidden\">\n      \n      {/* =========================================\n          1. HERO (Major Moment)\n          ========================================= */}\n      <section className=\"pt-32 pb-16 md:pt-40 md:pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full\">\n        <div className=\"grid lg:grid-cols-2 gap-16 lg:gap-8 items-center\">\n          <div className=\"max-w-xl\">\n            <motion.p \n              initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }}\n              className=\"text-brand-teal font-bold tracking-widest text-sm uppercase mb-6\"\n            >\n              Mortgage Broking, Made Personal\n            </motion.p>\n            <motion.h1 \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }}\n              className=\"font-serif text-5xl md:text-6xl lg:text-7xl font-normal text-brand-navy leading-[1.1] mb-8\"\n            >\n              Your priority is finding the right loan. Ours is making it happen.\n            </motion.h1>\n            <motion.p \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.2 }}\n              className=\"text-lg text-brand-text-muted mb-10 leading-relaxed font-medium\"\n            >\n              Whether you\'re buying a property, refinancing an existing loan, or building an investment portfolio, we provide the clarity and structure you need.\n            </motion.p>\n            \n            {/* Primary CTA Rhythm: Strong hero action */}\n            <motion.div \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}\n              className=\"flex flex-col sm:flex-row items-start sm:items-center gap-6 mb-10\"\n            >\n              <Link href=\"/services/home-loans\" className=\"inline-flex items-center justify-center px-8 py-4 bg-brand-teal text-white font-bold rounded-full hover:bg-brand-teal/90 transition-all shadow-[0_4px_14px_0_rgba(8,178,176,0.39)] hover:shadow-[0_6px_20px_rgba(8,178,176,0.23)] hover:-translate-y-0.5\">\n                Buy a Property\n              </Link>\n              <Link href=\"/services/refinance\" className=\"inline-flex items-center text-brand-navy font-bold hover:text-brand-teal transition-colors\">\n                Refinance <ChevronRight className=\"w-4 h-4 ml-1\" />\n              </Link>\n            </motion.div>\n\n            {/* Sub-hero trust detail */}\n            <motion.div \n              initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ delay: 0.5 }}\n              className=\"flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 text-sm font-semibold text-brand-text-muted pt-8 border-t border-brand-navy/10\"\n            >\n              <div className=\"flex items-center gap-x-6 gap-y-2\">\n                <span className=\"flex items-center gap-1.5\"><Check className=\"w-4 h-4 text-brand-teal\"/> Proudly Australian owned and operated</span>\n              </div>\n            </motion.div>\n          </div>\n\n          <motion.div \n            initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} transition={{ delay: 0.2, duration: 0.8 }}\n            className=\"relative\"\n          >\n            {/* Using a more authentic/human placeholder from Unsplash */}\n            <div className=\"relative h-[500px] md:h-[650px] w-full rounded-[2rem] overflow-hidden bg-slate-200\">\n              <Image\n                src=\"https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&q=80&w=1600\"\n                alt=\"Australian home lifestyle\"\n                fill\n                className=\"object-cover\"\n                priority\n              />\n            </div>\n            \n            {/* Purposeful Floating Info Card */}\n            <motion.div \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.6, type: \"spring\" }}\n              className=\"absolute -bottom-8 -left-4 md:-left-12 bg-white p-6 rounded-3xl shadow-[0_20px_50px_rgba(23,53,82,0.1)] border border-slate-100/50 w-72\"\n            >\n              <div className=\"flex items-center gap-4 mb-4\">\n                <div className=\"w-12 h-12 bg-brand-soft-teal rounded-full flex items-center justify-center\">\n                  <Check className=\"w-6 h-6 text-brand-teal\" />\n                </div>\n                <div>\n                  <p className=\"text-sm font-bold text-brand-navy uppercase tracking-wider\">Loan secured</p>\n                  <p className=\"text-sm text-brand-text-muted\">Investment Property</p>\n                </div>\n              </div>\n              <p className=\"text-3xl font-serif text-brand-navy mb-4\">$780,000</p>\n              <div className=\"w-full bg-slate-100 h-2 rounded-full overflow-hidden mb-2\">\n                <div className=\"bg-brand-teal w-full h-full rounded-full\"></div>\n              </div>\n              <p className=\"text-xs font-bold text-brand-teal text-right\">\342\234\223 Settled</p>\n            </motion.div>\n          </motion.div>\n        </div>\n      </section>\n\n      {/* =========================================\n          2. CREDIBILITY & LENDER STRIP (Quiet Texture)\n          ========================================= */}\n      <section className=\"border-y border-brand-navy/5 bg-white py-12\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-8 md:gap-16\">\n          \n          <div className=\"flex justify-between md:justify-start gap-8 md:gap-16 w-full md:w-auto\">\n            <div>\n              <p className=\"font-serif text-3xl text-brand-navy mb-1\">50+</p>\n              <p className=\"text-[10px] font-bold text-brand-text-muted uppercase tracking-widest\">Lenders</p>\n            </div>\n            <div>\n              <p className=\"font-serif text-3xl text-brand-navy mb-1\">15+</p>\n              <p className=\"text-[10px] font-bold text-brand-text-muted uppercase tracking-widest\">Years Exp</p>\n            </div>\n            <div>\n              <p className=\"font-serif text-3xl text-brand-navy mb-1\">4.9/5</p>\n              <p className=\"text-[10px] font-bold text-brand-text-muted uppercase tracking-widest\">Client Rating</p>\n            </div>\n          </div>\n          \n          {/* Subtle Lender Panel Representation */}\n          <div className=\"hidden md:flex flex-1 items-center justify-between gap-8 opacity-40 grayscale pl-16 border-l border-brand-navy/5\">\n             <span className=\"font-bold text-lg tracking-tighter\">COMMONWEALTH</span>\n             <span className=\"font-bold text-lg tracking-tighter\">ANZ</span>\n             <span className=\"font-bold text-lg tracking-tighter\">NAB</span>\n             <span className=\"font-bold text-lg tracking-tighter\">WESTPAC</span>\n             <span className=\"font-bold text-lg tracking-tighter\">MACQUARIE</span>\n          </div>\n        </div>\n      </section>\n\n      {/* =========================================\n          3. SERVICES ENTRY (Major Moment)\n          ========================================= */}\n      <section id=\"services\" className=\"py-24 md:py-32 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <p className=\"text-brand-teal font-bold tracking-widest text-sm uppercase mb-4\">How We Can Help</p>\n        <h2 className=\"font-serif text-4xl md:text-5xl text-brand-navy mb-16 max-w-2xl leading-tight\">\n          Whatever your next move, we\'re here to make it easier.\n        </h2>\n\n        <div className=\"grid md:grid-cols-2 gap-6\">\n          {helpCards.map((card, idx) => (\n            <motion.div \n              key={idx}\n              initial={{ opacity: 0, y: 20 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }} transition={{ delay: idx * 0.1 }}\n              className=\"bg-white p-10 rounded-[2rem] border border-slate-100/60 shadow-[0_4px_20px_rgb(0,0,0,0.02)] hover:shadow-[0_12px_40px_rgb(0,0,0,0.06)] transition-all group cursor-pointer\"\n            >\n              <div className=\"w-14 h-14 bg-brand-soft-teal rounded-full flex items-center justify-center mb-8 group-hover:scale-110 transition-transform duration-300\">\n                <card.icon className=\"w-6 h-6 text-brand-teal\" />\n              </div>\n              <h3 className=\"font-serif text-2xl text-brand-navy mb-3\">{card.title}</h3>\n              <p className=\"text-brand-text-muted font-medium mb-10 leading-relaxed max-w-sm\">{card.desc}</p>\n              \n              {/* Subtle Text Link CTA */}\n              <Link href={card.href} className=\"font-bold text-brand-navy text-sm flex items-center gap-2 group-hover:text-brand-teal transition-colors\">\n                {card.link} <ArrowRight className=\"w-4 h-4 transition-transform group-hover:translate-x-1\" />\n              </Link>\n            </motion.div>\n          ))}\n        </div>\n      </section>\n\n      {/* =========================================\n          4. BRAND DIFFERENCE & BROKER (Major Moment)\n          ========================================= */}\n      <section id=\"about\" className=\"bg-brand-navy text-white py-24 md:py-32 relative\">\n        <svg className=\"absolute top-0 w-full text-brand-warm fill-current -translate-y-[99%] pointer-events-none\" viewBox=\"0 0 1440 120\" preserveAspectRatio=\"none\">\n          <path d=\"M0,64L80,74.7C160,85,320,107,480,101.3C640,96,800,64,960,64C1120,64,1280,96,1360,112L1440,128L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z\"></path>\n        </svg>\n\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n          <div className=\"grid lg:grid-cols-2 gap-16 lg:gap-24\">\n            \n            {/* The Brand/Broker Narrative */}\n            <div>\n              <p className=\"text-brand-teal font-bold tracking-widest text-sm uppercase mb-4\">The RIVO Difference</p>\n              <h2 className=\"font-serif text-4xl md:text-5xl lg:text-6xl mb-8 leading-tight\">Mortgage advice that starts with you.</h2>\n              <p className=\"text-xl text-white/70 font-medium mb-12 max-w-md leading-relaxed\">\n                We specialize in helping Australian families, professionals, and investors structure loans that build long-term wealth. You won\'t be passed from department to department\342\200\224you\'ll have a dedicated expert in your corner.\n              </p>\n\n              <div className=\"flex items-center gap-6 mt-12\">\n                 <div className=\"w-16 h-16 rounded-full overflow-hidden relative border-2 border-white/10\">\n                    <Image src=\"https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&q=80&w=200\" alt=\"Broker\" fill className=\"object-cover\" />\n                 </div>\n                 <div>\n                   <p className=\"font-bold text-lg\">Meet the Team</p>\n                   <p className=\"text-sm text-brand-teal\">Real people, real support.</p>\n                 </div>\n              </div>\n            </div>\n\n            {/* The Process */}\n            <div className=\"space-y-10 lg:pt-12\">\n              {[\n                { title: \"Understand\", desc: \"We learn about your goals.\" },\n                { title: \"Compare\", desc: \"We compare suitable lenders.\" },\n                { title: \"Structure\", desc: \"We help structure the right loan.\" },\n                { title: \"Support\", desc: \"We\'re with you through settlement.\" }\n              ].map((step, i) => (\n                <div key={i} className=\"flex gap-6 items-start\">\n                  <div className=\"font-serif text-4xl md:text-5xl text-brand-teal opacity-80 leading-none\">0{i+1}</div>\n                  <div className=\"pt-1\">\n                    <h4 className=\"font-bold text-xl mb-1\">{step.title}</h4>\n                    <p className=\"text-white/60 text-base\">{step.desc}</p>\n                  </div>\n                </div>\n              ))}\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n      {/* =========================================\n          5. SOCIAL PROOF & FAQ (Quiet Texture)\n          ========================================= */}\n      <section className=\"py-24 bg-white border-t border-slate-100\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid md:grid-cols-2 gap-16 lg:gap-24 items-start\">\n            \n            {/* Reviews / Testimonials */}\n            <div>\n              <p className=\"text-brand-teal font-bold tracking-widest text-xs uppercase mb-8\">Client Stories</p>\n              <div className=\"flex gap-1 mb-6\">\n                {[1,2,3,4,5].map(s => <Star key={s} className=\"w-4 h-4 fill-brand-navy text-brand-navy\" />)}\n              </div>\n              <p className=\"font-serif text-2xl md:text-3xl text-brand-navy leading-snug mb-8\">\n                \"RIVO made what felt like a complicated process incredibly simple. We always knew what was happening and felt supported from our first conversation through to settlement.\"\n              </p>\n              <div>\n                <p className=\"font-bold text-brand-navy text-sm\">\342\200\224 Sarah & James</p>\n                <p className=\"text-brand-text-muted text-sm font-medium\">First Home Buyers</p>\n              </div>\n              \n              <div className=\"mt-12 pt-8 border-t border-slate-100 flex gap-12\">\n                 <div>\n                   <p className=\"font-bold text-sm text-brand-navy mb-1\">First Home</p>\n                   <p className=\"text-xs text-brand-text-muted\">Loan approved</p>\n                 </div>\n                 <div>\n                   <p className=\"font-bold text-sm text-brand-navy mb-1\">Refinance</p>\n                   <p className=\"text-xs text-brand-text-muted\">Debt consolidated</p>\n                 </div>\n                 <div>\n                   <p className=\"font-bold text-sm text-brand-navy mb-1\">Investment</p>\n                   <p className=\"text-xs text-brand-text-muted\">Portfolio strategy</p>\n                 </div>\n              </div>\n            </div>\n\n            {/* FAQ */}\n            <div>\n              <p className=\"text-brand-teal font-bold tracking-widest text-xs uppercase mb-8\">Common Questions</p>\n              <div className=\"space-y-4\">\n                {faqs.map((faq, idx) => (\n                  <div key={idx} className=\"border-b border-slate-100 pb-4\">\n                    <button \n                      onClick={() => setOpenFaq(openFaq === idx ? null : idx)}\n                      className=\"w-full flex items-center justify-between text-left focus:outline-none group\"\n                    >\n                      <span className=\"font-bold text-base text-brand-navy pr-8 py-2 group-hover:text-brand-teal transition-colors\">{faq.q}</span>\n                      {openFaq === idx ? (\n                        <Minus className=\"w-5 h-5 text-brand-teal flex-shrink-0\" />\n                      ) : (\n                        <Plus className=\"w-5 h-5 text-brand-teal flex-shrink-0\" />\n                      )}\n                    </button>\n                    {openFaq === idx && (\n                      <motion.div \n                        initial={{ opacity: 0, height: 0 }} animate={{ opacity: 1, height: \'auto\' }}\n                        className=\"pr-12 text-sm text-brand-text-muted font-medium leading-relaxed pb-2\"\n                      >\n                        {faq.a}\n                      </motion.div>\n                    )}\n                  </div>\n                ))}\n              </div>\n              <div className=\"mt-8\">\n                <Link href=\"/resources/faq\" className=\"inline-flex items-center text-sm font-bold text-brand-navy hover:text-brand-teal transition-colors\">\n                  View all FAQs <ArrowRight className=\"w-4 h-4 ml-1\" />\n                </Link>\n              </div>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n      {/* =========================================\n          7. FINAL CTA (Major Moment)\n          ========================================= */}\n      <section className=\"bg-gradient-to-br from-brand-teal to-brand-navy py-32 text-center text-white relative overflow-hidden\">\n        <div className=\"absolute bottom-0 w-full opacity-10 pointer-events-none translate-y-1/2\">\n           <svg viewBox=\"0 0 1440 320\" className=\"w-full h-auto fill-white\">\n             <path d=\"M0,160L48,176C96,192,192,224,288,213.3C384,203,480,149,576,149.3C672,149,768,203,864,224C960,245,1056,235,1152,202.7C1248,171,1344,117,1392,90.7L1440,64L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z\"></path>\n           </svg>\n        </div>\n\n        <div className=\"relative z-10 px-4\">\n          <p className=\"font-bold tracking-widest text-sm uppercase mb-8 text-white/80\">Ready to make your next move?</p>\n          <h2 className=\"font-serif text-5xl md:text-6xl mb-8 max-w-3xl mx-auto leading-tight\">\n            Let\'s find a loan that works for where you are \342\200\224 and where you\'re going.\n          </h2>\n          \n          <Link href=\"/contact\" className=\"inline-flex mt-8 items-center justify-center px-10 py-5 bg-white text-brand-navy text-lg font-bold rounded-full hover:bg-brand-soft-teal transition-all shadow-[0_8px_30px_rgb(255,255,255,0.12)] hover:shadow-[0_8px_30px_rgb(255,255,255,0.25)] hover:-translate-y-1\">\n            Book a consultation\n          </Link>\n          \n          <p className=\"mt-16 text-white/70 font-medium\">Prefer to talk? <br/><span className=\"text-3xl font-serif text-white mt-4 block\">\342\230\216 1300 XXX XXX</span></p>\n        </div>\n      </section>\n\n    </div>\n  );\n}\n"
        replacement_content: "\"use client\";\n\nimport { motion } from \"motion/react\";\nimport Image from \"next/image\";\nimport Link from \"next/link\";\nimport { useState } from \"react\";\nimport { Check, ArrowRight, Plus, Minus, Star, ChevronRight, Home, Building2, Hammer } from \"lucide-react\";\n\nexport default function HomePage() {\n  const [openFaq, setOpenFaq] = useState<number | null>(null);\n\n  const faqs = [\n    { q: \"Can I get a home loan with a small deposit?\", a: \"Yes, there are several options available including First Home Owner Grants, Lenders Mortgage Insurance (LMI), and guarantor loans. We can assess your specific situation and guide you through the best path.\" },\n    { q: \"How much can I borrow?\", a: \"Your borrowing capacity depends on your income, expenses, existing debts, and the size of your deposit. Use our calculator for an estimate, or speak to one of our brokers for an accurate assessment based on current lender policies.\" },\n    { q: \"Will applying affect my credit score?\", a: \"Having a preliminary conversation with us will not affect your credit score. We only submit a formal application once you are completely satisfied with the chosen loan product.\" },\n  ];\n\n  return (\n    <div className=\"flex flex-col font-sans overflow-x-hidden bg-white\">\n      \n      {/* =========================================\n          1. HERO (Major Moment - Finora Inspired Scale & Composition)\n          ========================================= */}\n      <section className=\"pt-32 md:pt-48 pb-24 md:pb-32 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full relative z-10\">\n        <div className=\"grid lg:grid-cols-12 gap-16 lg:gap-8 items-center\">\n          \n          <div className=\"lg:col-span-5 max-w-xl\">\n            <motion.p \n              initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }}\n              className=\"text-brand-teal font-bold tracking-widest text-xs uppercase mb-6\"\n            >\n              Find the right way home\n            </motion.p>\n            <motion.h1 \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }}\n              className=\"font-serif text-5xl md:text-6xl lg:text-[72px] font-normal text-brand-navy leading-[1.1] mb-8\"\n            >\n              Your priority is finding the right loan. Ours is making it happen.\n            </motion.h1>\n            <motion.p \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.2 }}\n              className=\"text-lg md:text-xl text-brand-text-muted mb-12 leading-relaxed font-medium max-w-lg\"\n            >\n              Whether you\'re buying a property, refinancing an existing loan, or building an investment portfolio, we provide the clarity and structure you need.\n            </motion.p>\n            \n            <motion.div \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}\n              className=\"flex flex-col sm:flex-row items-start sm:items-center gap-6\"\n            >\n              <Link href=\"/services/home-loans\" className=\"inline-flex items-center justify-center px-8 h-14 bg-brand-teal text-white font-bold rounded-full hover:bg-brand-teal/90 transition-all shadow-[0_4px_14px_0_rgba(8,178,176,0.39)] hover:shadow-[0_6px_20px_rgba(8,178,176,0.23)] hover:-translate-y-0.5\">\n                Buy a Property\n              </Link>\n              <Link href=\"/services/refinance\" className=\"inline-flex items-center text-brand-navy font-bold hover:text-brand-teal transition-colors group\">\n                Refinance <ChevronRight className=\"w-4 h-4 ml-1 transition-transform group-hover:translate-x-1\" />\n              </Link>\n            </motion.div>\n          </div>\n\n          <div className=\"lg:col-span-7 relative h-[600px] md:h-[700px] lg:-mr-12\">\n            {/* The Architectural Background Shape */}\n            <motion.div \n              initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} transition={{ duration: 1.2, ease: \"easeOut\" }}\n              className=\"absolute right-0 top-10 w-[85%] h-[85%] bg-brand-warm rounded-l-[4rem] rounded-tr-[2rem] rounded-br-[8rem] -z-10\"\n            />\n\n            {/* The Main Authentic Photography (physically integrated) */}\n            <motion.div\n              initial={{ opacity: 0, y: 40 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 1, delay: 0.2, ease: \"easeOut\" }}\n              className=\"absolute left-0 bottom-0 w-[80%] h-[75%] rounded-[2rem] overflow-hidden shadow-2xl\"\n            >\n              {/* Ambient slow drift animation on image */}\n              <motion.div\n                animate={{ y: [0, -15, 0] }}\n                transition={{ duration: 8, repeat: Infinity, ease: \"easeInOut\" }}\n                className=\"w-full h-[110%] relative -top-[5%]\"\n              >\n                <Image\n                  src=\"https://images.unsplash.com/photo-1512917774080-9991f1c4c750?auto=format&fit=crop&q=80&w=1600\"\n                  alt=\"Australian home lifestyle\"\n                  fill\n                  className=\"object-cover\"\n                  priority\n                  referrerPolicy=\"no-referrer\"\n                />\n              </motion.div>\n            </motion.div>\n\n            {/* Small unobtrusive information card */}\n            <motion.div \n              initial={{ opacity: 0, x: 20 }} animate={{ opacity: 1, x: 0 }} transition={{ delay: 0.6, type: \"spring\" }}\n              animate={{ y: [0, 10, 0] }} transition={{ y: { duration: 6, repeat: Infinity, ease: \"easeInOut\", delay: 1 } }}\n              className=\"absolute right-[5%] top-[45%] bg-white p-5 rounded-2xl shadow-[0_20px_50px_rgba(23,53,82,0.08)] border border-slate-100/50 w-64 z-20\"\n            >\n              <div className=\"flex items-start gap-3 mb-3\">\n                <div className=\"w-10 h-10 bg-brand-soft-teal rounded-full flex items-center justify-center flex-shrink-0 mt-0.5\">\n                  <Check className=\"w-5 h-5 text-brand-teal\" />\n                </div>\n                <div>\n                  <p className=\"text-xs font-bold text-brand-navy uppercase tracking-wider mb-1\">Clear Options</p>\n                  <p className=\"text-xs text-brand-text-muted leading-relaxed\">We\'ll help you understand exactly what you can borrow.</p>\n                </div>\n              </div>\n            </motion.div>\n\n          </div>\n        </div>\n      </section>\n\n      {/* =========================================\n          2. TRUST STRIP (Contrasting Band)\n          ========================================= */}\n      <section className=\"bg-brand-navy text-white py-16 md:py-20 relative z-20\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n           <div className=\"grid md:grid-cols-12 gap-12 items-center\">\n              \n              <div className=\"md:col-span-5 lg:col-span-6 pr-8 border-b md:border-b-0 md:border-r border-white/10 pb-10 md:pb-0\">\n                <h3 className=\"font-serif text-3xl md:text-4xl leading-tight mb-4\">Guidance that actually guides you.</h3>\n                <p className=\"text-white/70 font-medium text-lg max-w-md\">Personalised advice. Clear communication. Support through the entire process.</p>\n              </div>\n              \n              <div className=\"md:col-span-7 lg:col-span-6 flex flex-wrap sm:flex-nowrap justify-between gap-8 sm:gap-4 lg:pl-8\">\n                <div>\n                  <p className=\"font-serif text-4xl md:text-5xl text-brand-teal mb-2\">50+</p>\n                  <p className=\"text-[11px] font-bold text-white/50 uppercase tracking-widest\">Lenders</p>\n                </div>\n                <div>\n                  <p className=\"font-serif text-4xl md:text-5xl text-brand-teal mb-2\">15+</p>\n                  <p className=\"text-[11px] font-bold text-white/50 uppercase tracking-widest\">Years Exp</p>\n                </div>\n                <div>\n                  <p className=\"font-serif text-4xl md:text-5xl text-brand-teal mb-2\">4.9/5</p>\n                  <p className=\"text-[11px] font-bold text-white/50 uppercase tracking-widest\">Client Rating</p>\n                </div>\n              </div>\n\n           </div>\n        </div>\n      </section>\n\n      {/* =========================================\n          3. LENDING PATHWAYS (Large Asymmetric Cards)\n          ========================================= */}\n      <section id=\"services\" className=\"py-24 md:py-32 lg:py-40 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        <div className=\"mb-20\">\n          <p className=\"text-brand-teal font-bold tracking-widest text-xs uppercase mb-6\">How We Can Help</p>\n          <h2 className=\"font-serif text-4xl md:text-5xl lg:text-[56px] text-brand-navy max-w-3xl leading-[1.15]\">\n            Whatever your next move, we\'re here to make it easier.\n          </h2>\n        </div>\n\n        <div className=\"flex flex-col gap-8 md:gap-12\">\n          \n          {/* Row 1: Asymmetric Split (42% / 58%) */}\n          <div className=\"grid md:grid-cols-12 gap-8 md:gap-12\">\n            \n            {/* First Home (5 cols) */}\n            <motion.div \n              initial={{ opacity: 0, y: 30 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, margin: \"-100px\" }}\n              className=\"md:col-span-5 bg-brand-warm rounded-[2rem] overflow-hidden flex flex-col h-[550px] md:h-[650px] group\"\n            >\n              <div className=\"p-10 md:p-12 lg:p-14 flex-shrink-0\">\n                <h3 className=\"font-serif text-3xl text-brand-navy mb-4\">First Home</h3>\n                <p className=\"text-brand-text-muted font-medium mb-8 text-lg\">A simple path from pre-approval to settlement for your first home.</p>\n                <Link href=\"/services/home-loans\" className=\"font-bold text-brand-navy text-sm flex items-center gap-2 group-hover:text-brand-teal transition-colors w-fit\">\n                  Explore Home Loans <ArrowRight className=\"w-4 h-4 transition-transform group-hover:translate-x-1\" />\n                </Link>\n              </div>\n              <div className=\"relative flex-grow mt-auto mx-6 mb-6 rounded-2xl overflow-hidden shadow-lg\">\n                <Image src=\"https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&q=80&w=1200\" alt=\"First home\" fill className=\"object-cover group-hover:scale-105 transition-transform duration-700 ease-out\" referrerPolicy=\"no-referrer\" />\n              </div>\n            </motion.div>\n\n            {/* Refinancing (7 cols) */}\n            <motion.div \n              initial={{ opacity: 0, y: 30 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, margin: \"-100px\" }} transition={{ delay: 0.15 }}\n              className=\"md:col-span-7 bg-slate-50 border border-slate-100 rounded-[2rem] overflow-hidden flex flex-col h-[550px] md:h-[650px] group\"\n            >\n              <div className=\"p-10 md:p-12 lg:p-14 flex-shrink-0 flex flex-col sm:flex-row sm:justify-between sm:items-start gap-6\">\n                <div className=\"max-w-sm\">\n                  <h3 className=\"font-serif text-3xl text-brand-navy mb-4\">Refinancing</h3>\n                  <p className=\"text-brand-text-muted font-medium text-lg\">See if your current loan is still working for you and structure a better rate.</p>\n                </div>\n                <Link href=\"/services/refinance\" className=\"inline-flex h-12 px-6 items-center justify-center bg-white border border-slate-200 text-brand-navy text-sm font-bold rounded-full group-hover:border-brand-teal group-hover:text-brand-teal transition-colors whitespace-nowrap\">\n                  Explore Refinancing <ArrowRight className=\"w-4 h-4 ml-2 transition-transform group-hover:translate-x-1\" />\n                </Link>\n              </div>\n              <div className=\"relative flex-grow mt-auto mx-6 sm:mx-12 mb-6 sm:mb-12 rounded-2xl overflow-hidden shadow-xl\">\n                <Image src=\"https://images.unsplash.com/photo-1544465544-1b71aee9dfa3?auto=format&fit=crop&q=80&w=1200\" alt=\"Refinancing\" fill className=\"object-cover group-hover:scale-105 transition-transform duration-700 ease-out\" referrerPolicy=\"no-referrer\" />\n              </div>\n            </motion.div>\n\n          </div>\n\n          {/* Row 2: Asymmetric Split (7 cols / 5 cols) */}\n          <div className=\"grid md:grid-cols-12 gap-8 md:gap-12\">\n            \n            {/* Investment (7 cols) */}\n            <motion.div \n              initial={{ opacity: 0, y: 30 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, margin: \"-100px\" }}\n              className=\"md:col-span-7 bg-brand-soft-teal/30 rounded-[2rem] overflow-hidden flex flex-col h-[550px] md:h-[650px] group\"\n            >\n              <div className=\"p-10 md:p-12 lg:p-14 flex-shrink-0 flex flex-col sm:flex-row sm:justify-between sm:items-start gap-6\">\n                <div className=\"max-w-sm\">\n                  <h3 className=\"font-serif text-3xl text-brand-navy mb-4\">Investment</h3>\n                  <p className=\"text-brand-text-muted font-medium text-lg\">Build your property portfolio with a loan strategy designed around your financial goals.</p>\n                </div>\n                <Link href=\"/services/investment-loans\" className=\"inline-flex h-12 px-6 items-center justify-center bg-white border border-transparent text-brand-navy text-sm font-bold rounded-full group-hover:text-brand-teal transition-colors shadow-sm whitespace-nowrap\">\n                  Investment Loans <ArrowRight className=\"w-4 h-4 ml-2 transition-transform group-hover:translate-x-1\" />\n                </Link>\n              </div>\n              <div className=\"relative flex-grow mt-auto mx-6 sm:mx-12 mb-6 sm:mb-12 rounded-2xl overflow-hidden shadow-xl\">\n                <Image src=\"https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&q=80&w=1200\" alt=\"Investment properties\" fill className=\"object-cover group-hover:scale-105 transition-transform duration-700 ease-out\" referrerPolicy=\"no-referrer\" />\n              </div>\n            </motion.div>\n\n            {/* Build & Renovate (5 cols) */}\n            <motion.div \n              initial={{ opacity: 0, y: 30 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, margin: \"-100px\" }} transition={{ delay: 0.15 }}\n              className=\"md:col-span-5 bg-white border border-slate-100 rounded-[2rem] overflow-hidden flex flex-col h-[550px] md:h-[650px] group\"\n            >\n              <div className=\"p-10 md:p-12 lg:p-14 flex-shrink-0\">\n                <h3 className=\"font-serif text-3xl text-brand-navy mb-4\">Build & Renovate</h3>\n                <p className=\"text-brand-text-muted font-medium mb-8 text-lg\">Finance your construction project with confidence and clear draw-down structures.</p>\n                <Link href=\"/services/construction-loans\" className=\"font-bold text-brand-navy text-sm flex items-center gap-2 group-hover:text-brand-teal transition-colors w-fit\">\n                  Construction Loans <ArrowRight className=\"w-4 h-4 transition-transform group-hover:translate-x-1\" />\n                </Link>\n              </div>\n              <div className=\"relative flex-grow mt-auto mx-6 mb-6 rounded-2xl overflow-hidden shadow-sm border border-slate-100\">\n                <Image src=\"https://images.unsplash.com/photo-1503387762-592deb58ef4e?auto=format&fit=crop&q=80&w=1200\" alt=\"Build and renovate\" fill className=\"object-cover group-hover:scale-105 transition-transform duration-700 ease-out\" referrerPolicy=\"no-referrer\" />\n              </div>\n            </motion.div>\n\n          </div>\n        </div>\n\n      </section>\n\n      {/* =========================================\n          4. QUIET EDITORIAL (Alternating density)\n          ========================================= */}\n      <section className=\"py-24 md:py-32 bg-white\">\n        <div className=\"max-w-4xl mx-auto px-4 sm:px-6 text-center\">\n          <motion.h2 \n            initial={{ opacity: 0, y: 20 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }}\n            className=\"font-serif text-4xl md:text-5xl lg:text-[56px] text-brand-navy leading-[1.15] mb-8\"\n          >\n            A mortgage isn\'t one decision.<br/>It\'s a series of decisions.\n          </motion.h2>\n          <motion.p \n            initial={{ opacity: 0, y: 20 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }} transition={{ delay: 0.1 }}\n            className=\"text-lg md:text-xl text-brand-text-muted font-medium max-w-2xl mx-auto leading-relaxed\"\n          >\n            We don\'t just find a rate. We look at the bigger picture to ensure your loan structure works for your life today, and your goals for tomorrow.\n          </motion.p>\n        </div>\n      </section>\n\n      {/* =========================================\n          5. WHY RIVO (Offset Grid Composition)\n          ========================================= */}\n      <section id=\"about\" className=\"py-24 md:py-32 lg:py-40 bg-slate-50 border-y border-slate-100 overflow-hidden\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid lg:grid-cols-12 gap-16 lg:gap-8 items-center\">\n            \n            {/* Left Editorial */}\n            <div className=\"lg:col-span-5 max-w-lg\">\n              <p className=\"text-brand-teal font-bold tracking-widest text-xs uppercase mb-6\">The Rivo Difference</p>\n              <h2 className=\"font-serif text-4xl md:text-5xl lg:text-[56px] leading-[1.15] text-brand-navy mb-8\">\n                Mortgage advice shouldn\'t feel like a sales pitch.\n              </h2>\n              <p className=\"text-lg text-brand-text-muted font-medium mb-12 leading-relaxed\">\n                We specialize in helping Australian families, professionals, and investors structure loans that build long-term wealth. You won\'t be passed from department to department\342\200\224you\'ll have a dedicated expert in your corner.\n              </p>\n              <Link href=\"/contact\" className=\"inline-flex h-14 px-8 items-center justify-center bg-brand-navy text-white font-bold rounded-full hover:bg-brand-teal transition-colors shadow-lg hover:-translate-y-0.5\">\n                Talk to a broker\n              </Link>\n            </div>\n\n            {/* Right Offset Grid */}\n            <div className=\"lg:col-span-7 relative h-[600px] lg:h-[700px] lg:pl-12\">\n              <div className=\"grid grid-cols-2 gap-6 absolute inset-0\">\n                \n                {/* Column 1 (Normal) */}\n                <div className=\"flex flex-col gap-6 pt-12\">\n                  <motion.div \n                    initial={{ opacity: 0, y: 40 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }}\n                    className=\"bg-white p-8 md:p-10 rounded-3xl border border-slate-100 shadow-sm\"\n                  >\n                    <h4 className=\"font-serif text-2xl text-brand-navy mb-3\">Clear Advice</h4>\n                    <p className=\"text-brand-text-muted text-base leading-relaxed\">We strip away the jargon and explain exactly what your options mean for your wallet.</p>\n                  </motion.div>\n                  \n                  <motion.div \n                    initial={{ opacity: 0, y: 40 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }} transition={{ delay: 0.1 }}\n                    className=\"bg-white p-8 md:p-10 rounded-3xl border border-slate-100 shadow-sm relative overflow-hidden group\"\n                  >\n                    <div className=\"absolute inset-0 bg-brand-navy opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-0\"></div>\n                    <div className=\"relative z-10 transition-colors duration-500 group-hover:text-white\">\n                      <h4 className=\"font-serif text-2xl text-brand-navy mb-3 group-hover:text-white transition-colors duration-500\">We Listen</h4>\n                      <p className=\"text-brand-text-muted text-base leading-relaxed group-hover:text-white/70 transition-colors duration-500\">Your goals dictate the strategy, not the other way around.</p>\n                    </div>\n                  </motion.div>\n                </div>\n\n                {/* Column 2 (Offset by +70px approx) */}\n                <div className=\"flex flex-col gap-6 pt-24 lg:pt-32\">\n                  <motion.div \n                    initial={{ opacity: 0, y: 40 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }} transition={{ delay: 0.2 }}\n                    className=\"bg-brand-warm p-8 md:p-10 rounded-3xl shadow-sm\"\n                  >\n                    <h4 className=\"font-serif text-2xl text-brand-navy mb-3\">Less Stress</h4>\n                    <p className=\"text-brand-navy/70 text-base leading-relaxed\">We handle the paperwork, the lender follow-ups, and the settlement coordination.</p>\n                  </motion.div>\n\n                  <motion.div \n                    initial={{ opacity: 0, y: 40 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }} transition={{ delay: 0.3 }}\n                    className=\"bg-white p-8 md:p-10 rounded-3xl border border-slate-100 shadow-sm\"\n                  >\n                    <h4 className=\"font-serif text-2xl text-brand-navy mb-3\">Long-term</h4>\n                    <p className=\"text-brand-text-muted text-base leading-relaxed\">We check in annually to ensure your rate remains competitive.</p>\n                  </motion.div>\n                </div>\n\n              </div>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n      {/* =========================================\n          6. HUMAN PROOF & FAQ (Visual Anchor)\n          ========================================= */}\n      <section className=\"py-24 md:py-32 lg:py-40 bg-white\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid lg:grid-cols-2 gap-16 lg:gap-24 items-start\">\n            \n            {/* Story / Testimonial with large image anchor */}\n            <div>\n              <p className=\"text-brand-teal font-bold tracking-widest text-xs uppercase mb-8\">Client Stories</p>\n              \n              <div className=\"relative h-80 md:h-96 w-full rounded-[2rem] overflow-hidden mb-10\">\n                <Image src=\"https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?auto=format&fit=crop&q=80&w=1000\" alt=\"Client story\" fill className=\"object-cover\" referrerPolicy=\"no-referrer\" />\n              </div>\n\n              <div className=\"flex gap-1 mb-6\">\n                {[1,2,3,4,5].map(s => <Star key={s} className=\"w-4 h-4 fill-brand-navy text-brand-navy\" />)}\n              </div>\n              <p className=\"font-serif text-2xl md:text-[32px] text-brand-navy leading-[1.3] mb-8\">\n                \"RIVO made what felt like a complicated process incredibly simple. We always knew what was happening and felt supported from our first conversation through to settlement.\"\n              </p>\n              <div>\n                <p className=\"font-bold text-brand-navy text-sm\">\342\200\224 Sarah & James</p>\n                <p className=\"text-brand-text-muted text-sm font-medium\">First Home Buyers</p>\n              </div>\n            </div>\n\n            {/* FAQ Area (Tighter Utility Scale) */}\n            <div className=\"lg:pt-12\">\n              <p className=\"text-brand-teal font-bold tracking-widest text-xs uppercase mb-8\">Common Questions</p>\n              <div className=\"space-y-2\">\n                {faqs.map((faq, idx) => (\n                  <div key={idx} className=\"border-b border-slate-100 pb-2\">\n                    <button \n                      onClick={() => setOpenFaq(openFaq === idx ? null : idx)}\n                      className=\"w-full flex items-center justify-between text-left focus:outline-none group py-4\"\n                    >\n                      <span className=\"font-bold text-lg text-brand-navy pr-8 group-hover:text-brand-teal transition-colors\">{faq.q}</span>\n                      {openFaq === idx ? (\n                        <Minus className=\"w-5 h-5 text-brand-teal flex-shrink-0\" />\n                      ) : (\n                        <Plus className=\"w-5 h-5 text-brand-teal flex-shrink-0\" />\n                      )}\n                    </button>\n                    {openFaq === idx && (\n                      <motion.div \n                        initial={{ opacity: 0, height: 0 }} animate={{ opacity: 1, height: \'auto\' }}\n                        className=\"pr-12 text-base text-brand-text-muted font-medium leading-relaxed pb-6\"\n                      >\n                        {faq.a}\n                      </motion.div>\n                    )}\n                  </div>\n                ))}\n              </div>\n              <div className=\"mt-10\">\n                <Link href=\"/resources/faq\" className=\"inline-flex items-center text-sm font-bold text-brand-navy hover:text-brand-teal transition-colors group\">\n                  View all FAQs <ArrowRight className=\"w-4 h-4 ml-2 transition-transform group-hover:translate-x-1\" />\n                </Link>\n              </div>\n            </div>\n\n          </div>\n        </div>\n      </section>\n\n      {/* =========================================\n          7. FINAL CTA (Major Moment - Large and Simple)\n          ========================================= */}\n      <section className=\"bg-brand-navy py-32 md:py-40 text-center text-white relative overflow-hidden\">\n        {/* Subtle architectural shape in background */}\n        <div className=\"absolute inset-0 opacity-10 pointer-events-none flex justify-center items-center\">\n           <div className=\"w-[800px] h-[800px] rounded-full border-[1px] border-white absolute -translate-y-[20%] scale-150\"></div>\n           <div className=\"w-[1200px] h-[1200px] rounded-full border-[1px] border-white absolute -translate-y-[20%] scale-150\"></div>\n        </div>\n\n        <div className=\"relative z-10 px-4 max-w-4xl mx-auto\">\n          <p className=\"font-bold tracking-widest text-xs uppercase mb-8 text-brand-teal\">Ready to make your next move?</p>\n          <h2 className=\"font-serif text-5xl md:text-6xl lg:text-[72px] mb-12 leading-[1.1]\">\n            Let\'s find a loan that works for where you are \342\200\224 and where you\'re going.\n          </h2>\n          \n          <Link href=\"/contact\" className=\"inline-flex items-center justify-center h-16 px-12 bg-white text-brand-navy text-lg font-bold rounded-full hover:bg-brand-teal hover:text-white transition-all shadow-[0_8px_30px_rgb(255,255,255,0.12)] hover:-translate-y-1\">\n            Book a consultation\n          </Link>\n          \n          <p className=\"mt-16 text-white/60 font-medium\">Prefer to talk? <br/><span className=\"text-2xl font-serif text-white mt-4 block\">1300 XXX XXX</span></p>\n        </div>\n      </section>\n\n    </div>\n  );\n}\n"
      }
      num_matches: 1
    }
  }
}
