  file_change {
    absolute_path_uri: "file:///app/page.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "\"use client\";\n\nimport { motion } from \"motion/react\";\nimport { ArrowRight, Home, Building2, Briefcase, Landmark, CheckCircle2, Star, Menu, X, Phone, Mail, MapPin } from \"lucide-react\";\nimport { useState } from \"react\";\nimport Image from \"next/image\";\nimport { useForm } from \"react-hook-form\";\nimport { zodResolver } from \"@hookform/resolvers/zod\";\nimport * as z from \"zod\";\n\nconst formSchema = z.object({\n  firstName: z.string().min(2, { message: \"First name is required.\" }),\n  lastName: z.string().min(2, { message: \"Last name is required.\" }),\n  email: z.string().email({ message: \"Invalid email address.\" }),\n  phone: z.string().min(8, { message: \"Phone number is required.\" }),\n  loanPurpose: z.string().min(1, { message: \"Please select a loan purpose.\" }),\n  loanAmount: z.string().optional(),\n  message: z.string().optional(),\n});\n\nexport default function MortgageBrokerSite() {\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [isSuccess, setIsSuccess] = useState(false);\n\n  const { register, handleSubmit, formState: { errors }, reset } = useForm<z.infer<typeof formSchema>>({\n    resolver: zodResolver(formSchema),\n  });\n\n  const onSubmit = async (data: z.infer<typeof formSchema>) => {\n    setIsSubmitting(true);\n    // Simulate API call\n    await new Promise(resolve => setTimeout(resolve, 1500));\n    setIsSubmitting(false);\n    setIsSuccess(true);\n    reset();\n    setTimeout(() => setIsSuccess(false), 5000);\n  };\n\n  const navLinks = [\n    { name: \"Home\", href: \"#\" },\n    { name: \"Services\", href: \"#services\" },\n    { name: \"About Us\", href: \"#about\" },\n    { name: \"Testimonials\", href: \"#testimonials\" },\n    { name: \"Contact\", href: \"#contact\" },\n  ];\n\n  const services = [\n    {\n      title: \"First Home Buyer\",\n      description: \"Take the stress out of buying your first home with expert guidance every step of the way.\",\n      icon: Home,\n    },\n    {\n      title: \"Refinancing\",\n      description: \"Unlock a better rate or consolidate debt. We\'ll find the right loan to match your current needs.\",\n      icon: ArrowRight,\n    },\n    {\n      title: \"Property Investment\",\n      description: \"Strategic finance solutions to help you build and grow a successful property portfolio.\",\n      icon: Building2,\n    },\n    {\n      title: \"Commercial Loans\",\n      description: \"Finance tailored for your business needs, whether purchasing premises or managing cash flow.\",\n      icon: Briefcase,\n    },\n    {\n      title: \"Asset & Vehicle Finance\",\n      description: \"Competitive rates for cars, equipment, and other essential assets for personal or business use.\",\n      icon: Landmark,\n    },\n  ];\n\n  return (\n    <div className=\"min-h-screen flex flex-col font-sans\">\n      {/* Header */}\n      <header className=\"sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-10 h-10 bg-blue-900 rounded-lg flex items-center justify-center\">\n              <Home className=\"w-6 h-6 text-white\" />\n            </div>\n            <span className=\"font-serif font-bold text-2xl text-blue-950 tracking-tight\">Laxmi Home Loans</span>\n          </div>\n\n          {/* Desktop Nav */}\n          <nav className=\"hidden md:flex items-center gap-8\">\n            {navLinks.map((link) => (\n              <a key={link.name} href={link.href} className=\"text-sm font-medium text-slate-600 hover:text-blue-900 transition-colors\">\n                {link.name}\n              </a>\n            ))}\n            <a href=\"#contact\" className=\"px-5 py-2.5 bg-blue-900 text-white text-sm font-semibold rounded-md hover:bg-blue-800 transition-colors\">\n              Get an Assessment\n            </a>\n          </nav>\n\n          {/* Mobile Menu Button */}\n          <button \n            className=\"md:hidden p-2 text-slate-600\"\n            onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)}\n          >\n            {isMobileMenuOpen ? <X className=\"w-6 h-6\" /> : <Menu className=\"w-6 h-6\" />}\n          </button>\n        </div>\n\n        {/* Mobile Nav */}\n        {isMobileMenuOpen && (\n          <div className=\"md:hidden bg-white border-b border-slate-200 absolute w-full left-0\">\n            <nav className=\"flex flex-col p-4 gap-4\">\n              {navLinks.map((link) => (\n                <a \n                  key={link.name} \n                  href={link.href} \n                  className=\"text-base font-medium text-slate-800 py-2\"\n                  onClick={() => setIsMobileMenuOpen(false)}\n                >\n                  {link.name}\n                </a>\n              ))}\n              <a \n                href=\"#contact\" \n                className=\"w-full text-center px-5 py-3 bg-blue-900 text-white font-semibold rounded-md mt-2\"\n                onClick={() => setIsMobileMenuOpen(false)}\n              >\n                Get an Assessment\n              </a>\n            </nav>\n          </div>\n        )}\n      </header>\n\n      <main className=\"flex-grow\">\n        {/* Hero Section */}\n        <section className=\"relative pt-24 pb-32 lg:pt-36 lg:pb-40 overflow-hidden bg-slate-900\">\n          <div className=\"absolute inset-0 opacity-20\">\n            <Image\n              src=\"https://picsum.photos/seed/home-loan/1920/1080\"\n              alt=\"Beautiful modern home\"\n              fill\n              className=\"object-cover\"\n              referrerPolicy=\"no-referrer\"\n              priority\n            />\n          </div>\n          <div className=\"absolute inset-0 bg-gradient-to-r from-slate-900 via-slate-900/80 to-transparent\"></div>\n          \n          <div className=\"relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div className=\"max-w-2xl\">\n              <motion.h1 \n                initial={{ opacity: 0, y: 20 }}\n                animate={{ opacity: 1, y: 0 }}\n                transition={{ duration: 0.6 }}\n                className=\"font-serif text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6\"\n              >\n                Securing Your Future with the Right Loan\n              </motion.h1>\n              <motion.p \n                initial={{ opacity: 0, y: 20 }}\n                animate={{ opacity: 1, y: 0 }}\n                transition={{ duration: 0.6, delay: 0.1 }}\n                className=\"text-lg text-slate-300 mb-8 max-w-xl\"\n              >\n                We navigate the complex mortgage market to find the perfect tailored solution for you. Expert advice, seamless process, and dedicated support from application to settlement.\n              </motion.p>\n              <motion.div \n                initial={{ opacity: 0, y: 20 }}\n                animate={{ opacity: 1, y: 0 }}\n                transition={{ duration: 0.6, delay: 0.2 }}\n                className=\"flex flex-col sm:flex-row gap-4\"\n              >\n                <a href=\"#contact\" className=\"inline-flex items-center justify-center px-8 py-3.5 bg-amber-500 text-slate-900 font-semibold rounded-md hover:bg-amber-400 transition-colors text-base\">\n                  Free Consultation\n                </a>\n                <a href=\"#services\" className=\"inline-flex items-center justify-center px-8 py-3.5 bg-white/10 text-white font-semibold rounded-md hover:bg-white/20 transition-colors border border-white/20 text-base\">\n                  Explore Services\n                </a>\n              </motion.div>\n            </div>\n          </div>\n        </section>\n\n        {/* Why Choose Us / Highlights */}\n        <section className=\"py-16 bg-white border-b border-slate-100\">\n          <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div className=\"grid md:grid-cols-3 gap-8\">\n              {[\n                { title: \"Access to 40+ Lenders\", desc: \"We compare thousands of home loan products from major banks and specialist lenders to find your perfect fit.\" },\n                { title: \"Expert Advice at No Cost\", desc: \"Our service is completely free for you. We get paid by the lender you choose, meaning unbiased, expert advice.\" },\n                { title: \"Tailored to Your Goals\", desc: \"Every financial situation is unique. We structure your loan to align with your short-term needs and long-term goals.\" }\n              ].map((feature, idx) => (\n                <div key={idx} className=\"flex gap-4\">\n                  <div className=\"flex-shrink-0 mt-1\">\n                    <CheckCircle2 className=\"w-6 h-6 text-amber-500\" />\n                  </div>\n                  <div>\n                    <h3 className=\"font-semibold text-slate-900 text-lg mb-2\">{feature.title}</h3>\n                    <p className=\"text-slate-600 leading-relaxed\">{feature.desc}</p>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </section>\n\n        {/* Services Section */}\n        <section id=\"services\" className=\"py-24 bg-slate-50\">\n          <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div className=\"text-center max-w-2xl mx-auto mb-16\">\n              <h2 className=\"font-serif text-3xl md:text-4xl font-bold text-slate-900 mb-4\">Our Services</h2>\n              <p className=\"text-slate-600 text-lg\">Whether you are buying your first home or expanding your business, we have the right finance solution.</p>\n            </div>\n\n            <div className=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-8\">\n              {services.map((service, idx) => (\n                <motion.div \n                  key={idx}\n                  initial={{ opacity: 0, y: 20 }}\n                  whileInView={{ opacity: 1, y: 0 }}\n                  viewport={{ once: true }}\n                  transition={{ delay: idx * 0.1 }}\n                  className=\"bg-white p-8 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow group\"\n                >\n                  <div className=\"w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center mb-6 group-hover:bg-blue-600 transition-colors\">\n                    <service.icon className=\"w-6 h-6 text-blue-600 group-hover:text-white transition-colors\" />\n                  </div>\n                  <h3 className=\"text-xl font-bold text-slate-900 mb-3\">{service.title}</h3>\n                  <p className=\"text-slate-600 mb-6\">{service.description}</p>\n                  <a href=\"#contact\" className=\"inline-flex items-center font-semibold text-blue-600 hover:text-blue-800\">\n                    Learn more <ArrowRight className=\"w-4 h-4 ml-1\" />\n                  </a>\n                </motion.div>\n              ))}\n            </div>\n          </div>\n        </section>\n\n        {/* About Section */}\n        <section id=\"about\" className=\"py-24 bg-white\">\n          <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div className=\"grid lg:grid-cols-2 gap-16 items-center\">\n              <div className=\"relative h-[500px] rounded-2xl overflow-hidden\">\n                <Image\n                  src=\"https://picsum.photos/seed/broker-meeting/800/1000\"\n                  alt=\"Broker consulting with clients\"\n                  fill\n                  className=\"object-cover\"\n                  referrerPolicy=\"no-referrer\"\n                />\n              </div>\n              <div>\n                <h2 className=\"font-serif text-3xl md:text-4xl font-bold text-slate-900 mb-6\">Your Trusted Partner in Finance</h2>\n                <p className=\"text-slate-600 text-lg mb-6 leading-relaxed\">\n                  At Laxmi Home Loans, we believe that securing a mortgage shouldn\'t be a daunting task. With years of industry experience and deep relationships with over 40 leading lenders, we simplify the complex world of finance.\n                </p>\n                <p className=\"text-slate-600 text-lg mb-8 leading-relaxed\">\n                  Our commitment is to transparency, integrity, and putting your interests first. From our initial consultation to settlement and beyond, we are here to support your financial journey.\n                </p>\n                <ul className=\"space-y-4 mb-8\">\n                  {[\n                    \"Award-winning mortgage professionals\",\n                    \"Personalized financial strategy formulation\",\n                    \"End-to-end application management\",\n                    \"Ongoing rate reviews post-settlement\"\n                  ].map((item, i) => (\n                    <li key={i} className=\"flex items-center text-slate-700\">\n                      <CheckCircle2 className=\"w-5 h-5 text-green-500 mr-3 flex-shrink-0\" />\n                      {item}\n                    </li>\n                  ))}\n                </ul>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        {/* Testimonials */}\n        <section id=\"testimonials\" className=\"py-24 bg-blue-900 text-white\">\n          <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div className=\"text-center max-w-2xl mx-auto mb-16\">\n              <h2 className=\"font-serif text-3xl md:text-4xl font-bold mb-4\">What Our Clients Say</h2>\n              <p className=\"text-blue-200 text-lg\">Don\'t just take our word for it. Here is what people are saying about their experience with us.</p>\n            </div>\n\n            <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8\">\n              {[\n                { name: \"Sarah M.\", role: \"First Home Buyer\", text: \"The team made buying our first home an absolute breeze. They explained every detail clearly and secured a rate much lower than our bank offered.\" },\n                { name: \"David & Emma L.\", role: \"Property Investors\", text: \"Exceptional service. They restructured our portfolio financing, unlocking equity we didn\'t know we had to purchase our third investment property.\" },\n                { name: \"Michael T.\", role: \"Refinancer\", text: \"I was skeptical about refinancing, but they walked me through the numbers. We are now saving over $400 a month. Highly recommended!\" }\n              ].map((t, i) => (\n                <div key={i} className=\"bg-blue-800/50 p-8 rounded-2xl border border-blue-700/50\">\n                  <div className=\"flex gap-1 mb-4\">\n                    {[1,2,3,4,5].map(star => <Star key={star} className=\"w-5 h-5 fill-amber-400 text-amber-400\" />)}\n                  </div>\n                  <p className=\"text-blue-50 mb-6 italic\">\"{t.text}\"</p>\n                  <div>\n                    <p className=\"font-bold\">{t.name}</p>\n                    <p className=\"text-blue-300 text-sm\">{t.role}</p>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </section>\n\n        {/* Lead Capture / Contact Section */}\n        <section id=\"contact\" className=\"py-24 bg-slate-50\">\n          <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n            <div className=\"bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-100 flex flex-col lg:flex-row\">\n              \n              {/* Form Side */}\n              <div className=\"lg:w-3/5 p-8 md:p-12\">\n                <h2 className=\"font-serif text-3xl font-bold text-slate-900 mb-2\">Request a Free Assessment</h2>\n                <p className=\"text-slate-600 mb-8\">Fill out the form below and one of our mortgage specialists will be in touch shortly.</p>\n                \n                {isSuccess ? (\n                  <div className=\"bg-green-50 text-green-800 p-6 rounded-xl border border-green-200 flex flex-col items-center justify-center text-center py-12\">\n                    <CheckCircle2 className=\"w-12 h-12 text-green-500 mb-4\" />\n                    <h3 className=\"text-xl font-bold mb-2\">Request Received!</h3>\n                    <p>Thank you for reaching out. A member of our team will contact you within 24 hours.</p>\n                  </div>\n                ) : (\n                  <form onSubmit={handleSubmit(onSubmit)} className=\"space-y-6\">\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                      <div className=\"space-y-2\">\n                        <label className=\"text-sm font-semibold text-slate-900\">First Name <span className=\"text-red-500\">*</span></label>\n                        <input \n                          {...register(\"firstName\")}\n                          className=\"w-full px-4 py-3 rounded-md border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow bg-slate-50\"\n                          placeholder=\"John\"\n                        />\n                        {errors.firstName && <p className=\"text-red-500 text-sm\">{errors.firstName.message}</p>}\n                      </div>\n                      <div className=\"space-y-2\">\n                        <label className=\"text-sm font-semibold text-slate-900\">Last Name <span className=\"text-red-500\">*</span></label>\n                        <input \n                          {...register(\"lastName\")}\n                          className=\"w-full px-4 py-3 rounded-md border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow bg-slate-50\"\n                          placeholder=\"Doe\"\n                        />\n                        {errors.lastName && <p className=\"text-red-500 text-sm\">{errors.lastName.message}</p>}\n                      </div>\n                    </div>\n\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                      <div className=\"space-y-2\">\n                        <label className=\"text-sm font-semibold text-slate-900\">Email Address <span className=\"text-red-500\">*</span></label>\n                        <input \n                          {...register(\"email\")}\n                          type=\"email\"\n                          className=\"w-full px-4 py-3 rounded-md border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow bg-slate-50\"\n                          placeholder=\"john@example.com\"\n                        />\n                        {errors.email && <p className=\"text-red-500 text-sm\">{errors.email.message}</p>}\n                      </div>\n                      <div className=\"space-y-2\">\n                        <label className=\"text-sm font-semibold text-slate-900\">Phone Number <span className=\"text-red-500\">*</span></label>\n                        <input \n                          {...register(\"phone\")}\n                          className=\"w-full px-4 py-3 rounded-md border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow bg-slate-50\"\n                          placeholder=\"0400 000 000\"\n                        />\n                        {errors.phone && <p className=\"text-red-500 text-sm\">{errors.phone.message}</p>}\n                      </div>\n                    </div>\n\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                      <div className=\"space-y-2\">\n                        <label className=\"text-sm font-semibold text-slate-900\">How can we help? <span className=\"text-red-500\">*</span></label>\n                        <select \n                          {...register(\"loanPurpose\")}\n                          className=\"w-full px-4 py-3 rounded-md border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow bg-slate-50 appearance-none\"\n                        >\n                          <option value=\"\">Select a service</option>\n                          <option value=\"first_home\">Buying First Home</option>\n                          <option value=\"refinance\">Refinancing</option>\n                          <option value=\"investment\">Property Investment</option>\n                          <option value=\"commercial\">Commercial Loan</option>\n                          <option value=\"other\">Other</option>\n                        </select>\n                        {errors.loanPurpose && <p className=\"text-red-500 text-sm\">{errors.loanPurpose.message}</p>}\n                      </div>\n                      <div className=\"space-y-2\">\n                        <label className=\"text-sm font-semibold text-slate-900\">Estimated Loan Amount</label>\n                        <input \n                          {...register(\"loanAmount\")}\n                          className=\"w-full px-4 py-3 rounded-md border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow bg-slate-50\"\n                          placeholder=\"e.g. $500,000\"\n                        />\n                      </div>\n                    </div>\n\n                    <div className=\"space-y-2\">\n                      <label className=\"text-sm font-semibold text-slate-900\">Additional Information</label>\n                      <textarea \n                        {...register(\"message\")}\n                        rows={4}\n                        className=\"w-full px-4 py-3 rounded-md border border-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow bg-slate-50\"\n                        placeholder=\"Tell us a bit more about your situation...\"\n                      />\n                    </div>\n\n                    <button \n                      type=\"submit\" \n                      disabled={isSubmitting}\n                      className=\"w-full py-4 px-6 bg-blue-900 text-white font-bold rounded-md hover:bg-blue-800 transition-colors disabled:opacity-70 flex justify-center items-center gap-2\"\n                    >\n                      {isSubmitting ? (\n                        <span className=\"w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin\"></span>\n                      ) : (\n                        \"Submit Request\"\n                      )}\n                    </button>\n                  </form>\n                )}\n              </div>\n\n              {/* Info Side */}\n              <div className=\"lg:w-2/5 bg-slate-900 text-white p-8 md:p-12 relative overflow-hidden flex flex-col justify-between\">\n                <div className=\"absolute top-0 right-0 -mt-16 -mr-16 w-64 h-64 bg-blue-800/30 rounded-full blur-3xl\"></div>\n                <div className=\"absolute bottom-0 left-0 -mb-16 -ml-16 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl\"></div>\n                \n                <div className=\"relative z-10\">\n                  <h3 className=\"font-serif text-2xl font-bold mb-8\">Contact Information</h3>\n                  \n                  <div className=\"space-y-8\">\n                    <div className=\"flex items-start gap-4\">\n                      <div className=\"w-10 h-10 bg-blue-800/50 rounded-full flex items-center justify-center flex-shrink-0\">\n                        <Phone className=\"w-5 h-5 text-amber-400\" />\n                      </div>\n                      <div>\n                        <p className=\"text-sm text-slate-400 font-medium mb-1\">Call Us Directly</p>\n                        <p className=\"text-lg font-semibold\">1300 123 456</p>\n                      </div>\n                    </div>\n                    \n                    <div className=\"flex items-start gap-4\">\n                      <div className=\"w-10 h-10 bg-blue-800/50 rounded-full flex items-center justify-center flex-shrink-0\">\n                        <Mail className=\"w-5 h-5 text-amber-400\" />\n                      </div>\n                      <div>\n                        <p className=\"text-sm text-slate-400 font-medium mb-1\">Email Support</p>\n                        <p className=\"text-lg font-semibold\">info@laxmihomeloans.com.au</p>\n                      </div>\n                    </div>\n                    \n                    <div className=\"flex items-start gap-4\">\n                      <div className=\"w-10 h-10 bg-blue-800/50 rounded-full flex items-center justify-center flex-shrink-0\">\n                        <MapPin className=\"w-5 h-5 text-amber-400\" />\n                      </div>\n                      <div>\n                        <p className=\"text-sm text-slate-400 font-medium mb-1\">Office Location</p>\n                        <p className=\"text-lg font-semibold\">123 Finance Street<br/>Sydney NSW 2000</p>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"relative z-10 mt-16 pt-8 border-t border-slate-700/50\">\n                  <p className=\"text-sm text-slate-400\">\n                    Office Hours:<br/>\n                    Monday - Friday: 9:00 AM - 5:30 PM<br/>\n                    Saturday: By appointment only\n                  </p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n      </main>\n\n      {/* Footer */}\n      <footer className=\"bg-slate-950 text-slate-400 py-12 border-t border-slate-900\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid md:grid-cols-4 gap-8 mb-8\">\n            <div className=\"md:col-span-2\">\n              <div className=\"flex items-center gap-2 mb-4\">\n                <div className=\"w-8 h-8 bg-blue-900 rounded-lg flex items-center justify-center\">\n                  <Home className=\"w-4 h-4 text-white\" />\n                </div>\n                <span className=\"font-serif font-bold text-xl text-white tracking-tight\">Laxmi Home Loans</span>\n              </div>\n              <p className=\"text-sm max-w-sm mb-4\">\n                Your trusted mortgage broker providing expert financial solutions. We compare 40+ lenders to find the best home loan for you.\n              </p>\n              <p className=\"text-xs text-slate-500\">\n                Laxmi Home Loans is a credit representative of Australian Credit Licence XXXXXX.\n              </p>\n            </div>\n            \n            <div>\n              <h4 className=\"text-white font-semibold mb-4\">Quick Links</h4>\n              <ul className=\"space-y-2 text-sm\">\n                <li><a href=\"#\" className=\"hover:text-amber-400 transition-colors\">Home</a></li>\n                <li><a href=\"#services\" className=\"hover:text-amber-400 transition-colors\">Services</a></li>\n                <li><a href=\"#about\" className=\"hover:text-amber-400 transition-colors\">About Us</a></li>\n                <li><a href=\"#testimonials\" className=\"hover:text-amber-400 transition-colors\">Testimonials</a></li>\n              </ul>\n            </div>\n            \n            <div>\n              <h4 className=\"text-white font-semibold mb-4\">Services</h4>\n              <ul className=\"space-y-2 text-sm\">\n                <li><a href=\"#services\" className=\"hover:text-amber-400 transition-colors\">First Home Buyer</a></li>\n                <li><a href=\"#services\" className=\"hover:text-amber-400 transition-colors\">Refinancing</a></li>\n                <li><a href=\"#services\" className=\"hover:text-amber-400 transition-colors\">Investment Loans</a></li>\n                <li><a href=\"#services\" className=\"hover:text-amber-400 transition-colors\">Commercial Finance</a></li>\n              </ul>\n            </div>\n          </div>\n          \n          <div className=\"pt-8 border-t border-slate-800 text-xs flex flex-col md:flex-row justify-between items-center gap-4 text-slate-500\">\n            <p>&copy; {new Date().getFullYear()} Laxmi Home Loans. All rights reserved.</p>\n            <div className=\"flex gap-4\">\n              <a href=\"#\" className=\"hover:text-white transition-colors\">Privacy Policy</a>\n              <a href=\"#\" className=\"hover:text-white transition-colors\">Terms of Service</a>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>\n  );\n}"
    }
