        lines {
          text: "    { q: \"Can I get a home loan with a small deposit?\", a: \"Yes, there are several options available including First Home Owner Grants, Lenders Mortgage Insurance (LMI), and guarantor loans. We can assess your specific situation and guide you through the best path.\" },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
