  file_change {
    absolute_path_uri: "file:///app/page.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "\"use client\";\n\nimport { motion } from \"motion/react\";\nimport Image from \"next/image\";\nimport Link from \"next/link\";\nimport { useState } from \"react\";\nimport { Check, ArrowRight, Home, Building2, Hammer, Plus, Minus, Star } from \"lucide-react\";\n\nexport default function HomePage() {\n  const [propertyValue, setPropertyValue] = useState(750000);\n  const [deposit, setDeposit] = useState(150000);\n  \n  const loanAmount = Math.max(0, propertyValue - deposit);\n  const lvr = propertyValue > 0 ? ((loanAmount / propertyValue) * 100).toFixed(1) : \"0.0\";\n  \n  // Generic 6% over 30 years calculation\n  const monthlyRate = 0.06 / 12;\n  const numPayments = 30 * 12;\n  const monthlyRepayment = loanAmount > 0 \n    ? (loanAmount * monthlyRate * Math.pow(1 + monthlyRate, numPayments)) / (Math.pow(1 + monthlyRate, numPayments) - 1)\n    : 0;\n\n  const [openFaq, setOpenFaq] = useState<number | null>(0);\n\n  const formatCurrency = (val: number) => {\n    return new Intl.NumberFormat(\'en-AU\', { style: \'currency\', currency: \'AUD\', maximumFractionDigits: 0 }).format(val);\n  };\n\n  const helpCards = [\n    { title: \"Buy a Home\", desc: \"First home, next home or forever home.\", link: \"Explore Home Loans\", icon: Home },\n    { title: \"Refinance\", desc: \"See whether your current loan is still working for you.\", link: \"Explore Refinancing\", icon: ArrowRight },\n    { title: \"Invest\", desc: \"Build your property portfolio with a loan strategy designed around you.\", link: \"Investment Loans\", icon: Building2 },\n    { title: \"Build & Renovate\", desc: \"Finance your next project with confidence.\", link: \"Construction Loans\", icon: Hammer },\n  ];\n\n  const journeySteps = [\n    { title: \"Discover\", desc: \"We understand your goals, income and circumstances.\" },\n    { title: \"Compare\", desc: \"We search across our extensive lender panel.\" },\n    { title: \"Apply\", desc: \"We manage the application and keep you informed.\" },\n    { title: \"Settle\", desc: \"You get the keys. We\'re still here when you need us.\" },\n  ];\n\n  const faqs = [\n    { q: \"Can I get a home loan with a small deposit?\", a: \"Yes, there are several options available including First Home Owner Grants, Lenders Mortgage Insurance (LMI), and guarantor loans. We can assess your specific situation and guide you through the best path.\" },\n    { q: \"How much can I borrow?\", a: \"Your borrowing capacity depends on your income, expenses, existing debts, and the size of your deposit. Use our calculator for an estimate, or speak to one of our brokers for an accurate assessment based on current lender policies.\" },\n    { q: \"Will applying affect my credit score?\", a: \"Having a preliminary conversation with us will not affect your credit score. We only submit a formal application to a lender\342\200\224which does record a credit enquiry\342\200\224once you are completely satisfied with the chosen loan product.\" },\n    { q: \"How does refinancing work?\", a: \"Refinancing involves replacing your current home loan with a new one, usually with a different lender, to secure a lower interest rate, access equity, or consolidate debt. We handle the entire transition process for you.\" },\n  ];\n\n  return (\n    <div className=\"flex flex-col font-sans overflow-x-hidden\">\n      \n      {/* 1. Hero Section - Split Composition */}\n      <section className=\"pt-32 pb-16 md:pt-40 md:pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full\">\n        <div className=\"grid lg:grid-cols-2 gap-16 lg:gap-8 items-center\">\n          <div className=\"max-w-xl\">\n            <motion.p \n              initial={{ opacity: 0, y: 10 }} animate={{ opacity: 1, y: 0 }}\n              className=\"text-brand-teal font-bold tracking-widest text-sm uppercase mb-6\"\n            >\n              Mortgage Broking, Made Personal\n            </motion.p>\n            <motion.h1 \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.1 }}\n              className=\"font-serif text-5xl md:text-6xl lg:text-7xl font-normal text-brand-navy leading-[1.1] mb-8\"\n            >\n              Your next move starts with the right loan.\n            </motion.h1>\n            <motion.p \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.2 }}\n              className=\"text-lg text-brand-text-muted mb-10 leading-relaxed font-medium\"\n            >\n              Whether you\'re buying your first home, refinancing, investing or building, RIVO Lending helps you navigate your options and find a loan that fits your goals.\n            </motion.p>\n            <motion.div \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.3 }}\n              className=\"flex flex-col sm:flex-row gap-5 mb-10\"\n            >\n              <Link href=\"/contact\" className=\"inline-flex items-center justify-center px-8 py-4 bg-brand-teal text-white font-bold rounded-full hover:bg-brand-teal/90 transition-all shadow-[0_4px_14px_0_rgba(8,178,176,0.39)] hover:shadow-[0_6px_20px_rgba(8,178,176,0.23)] hover:-translate-y-0.5\">\n                Get Started \342\206\222\n              </Link>\n              <Link href=\"/contact\" className=\"inline-flex items-center justify-center px-8 py-4 bg-white text-brand-navy font-bold rounded-full border-2 border-brand-navy hover:bg-brand-navy/5 transition-colors\">\n                Talk to a Broker\n              </Link>\n            </motion.div>\n            <motion.div \n              initial={{ opacity: 0 }} animate={{ opacity: 1 }} transition={{ delay: 0.5 }}\n              className=\"flex flex-wrap items-center gap-x-6 gap-y-2 text-sm font-semibold text-brand-text-muted\"\n            >\n              <span className=\"flex items-center gap-1.5\"><Check className=\"w-4 h-4 text-brand-teal\"/> 50+ lenders</span>\n              <span className=\"flex items-center gap-1.5\"><Check className=\"w-4 h-4 text-brand-teal\"/> Personal guidance</span>\n              <span className=\"flex items-center gap-1.5\"><Check className=\"w-4 h-4 text-brand-teal\"/> Clear advice</span>\n            </motion.div>\n          </div>\n\n          <motion.div \n            initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} transition={{ delay: 0.2, duration: 0.8 }}\n            className=\"relative\"\n          >\n            <div className=\"relative h-[500px] md:h-[650px] w-full rounded-[2rem] overflow-hidden bg-slate-200\">\n              <Image\n                src=\"https://picsum.photos/id/1031/1200/1600\"\n                alt=\"Australian home lifestyle\"\n                fill\n                className=\"object-cover\"\n                priority\n              />\n            </div>\n            \n            {/* Purposeful Floating Info Card */}\n            <motion.div \n              initial={{ opacity: 0, y: 20 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 0.6, type: \"spring\" }}\n              className=\"absolute -bottom-8 -left-4 md:-left-12 bg-white p-6 rounded-3xl shadow-[0_20px_50px_rgba(23,53,82,0.1)] border border-slate-100/50 w-72\"\n            >\n              <div className=\"flex items-center gap-4 mb-4\">\n                <div className=\"w-12 h-12 bg-brand-soft-teal rounded-full flex items-center justify-center\">\n                  <Check className=\"w-6 h-6 text-brand-teal\" />\n                </div>\n                <div>\n                  <p className=\"text-sm font-bold text-brand-navy uppercase tracking-wider\">Loan secured</p>\n                  <p className=\"text-sm text-brand-text-muted\">Investment Property</p>\n                </div>\n              </div>\n              <p className=\"text-3xl font-serif text-brand-navy mb-4\">$780,000</p>\n              <div className=\"w-full bg-slate-100 h-2 rounded-full overflow-hidden mb-2\">\n                <div className=\"bg-brand-teal w-full h-full rounded-full\"></div>\n              </div>\n              <p className=\"text-xs font-bold text-brand-teal text-right\">\342\234\223 Settled</p>\n            </motion.div>\n          </motion.div>\n        </div>\n      </section>\n\n      {/* 2. Trust Strip */}\n      <section className=\"border-y border-brand-navy/5 bg-white py-16\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <p className=\"text-center text-sm font-bold tracking-widest uppercase text-brand-text-muted mb-10\">Trusted to help Australians move forward</p>\n          <div className=\"grid grid-cols-2 md:grid-cols-4 gap-8 text-center divide-x divide-brand-navy/5\">\n            <div>\n              <p className=\"font-serif text-4xl text-brand-navy mb-2\">50+</p>\n              <p className=\"text-sm font-semibold text-brand-text-muted\">Lenders compared</p>\n            </div>\n            <div>\n              <p className=\"font-serif text-4xl text-brand-navy mb-2\">15+</p>\n              <p className=\"text-sm font-semibold text-brand-text-muted\">Years experience</p>\n            </div>\n            <div>\n              <p className=\"font-serif text-4xl text-brand-navy mb-2\">$500m+</p>\n              <p className=\"text-sm font-semibold text-brand-text-muted\">Loans settled</p>\n            </div>\n            <div>\n              <p className=\"font-serif text-4xl text-brand-navy mb-2\">4.9/5</p>\n              <p className=\"text-sm font-semibold text-brand-text-muted\">Client rating</p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* 3. How RIVO helps */}\n      <section className=\"py-32 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <p className=\"text-brand-teal font-bold tracking-widest text-sm uppercase mb-4\">How We Can Help</p>\n        <h2 className=\"font-serif text-4xl md:text-5xl text-brand-navy mb-16 max-w-2xl leading-tight\">\n          Whatever your next move, we\'re here to make it easier.\n        </h2>\n\n        <div className=\"grid md:grid-cols-2 gap-6\">\n          {helpCards.map((card, idx) => (\n            <motion.div \n              key={idx}\n              initial={{ opacity: 0, y: 20 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }} transition={{ delay: idx * 0.1 }}\n              className=\"bg-white p-10 rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] hover:shadow-[0_20px_50px_rgb(0,0,0,0.08)] transition-shadow group cursor-pointer\"\n            >\n              <div className=\"w-14 h-14 bg-brand-soft-teal rounded-full flex items-center justify-center mb-8 group-hover:scale-110 transition-transform duration-300\">\n                <card.icon className=\"w-6 h-6 text-brand-teal\" />\n              </div>\n              <h3 className=\"font-serif text-2xl text-brand-navy mb-3\">{card.title}</h3>\n              <p className=\"text-brand-text-muted font-medium mb-10 leading-relaxed max-w-sm\">{card.desc}</p>\n              <p className=\"font-bold text-brand-navy flex items-center gap-2 group-hover:text-brand-teal transition-colors\">\n                {card.link} <ArrowRight className=\"w-4 h-4 transition-transform group-hover:translate-x-1\" />\n              </p>\n            </motion.div>\n          ))}\n        </div>\n      </section>\n\n      {/* 4. The RIVO Difference (Navy background with Wave) */}\n      <section className=\"bg-brand-navy text-white py-32 relative\">\n        <svg className=\"absolute top-0 w-full text-brand-warm fill-current -translate-y-[99%] pointer-events-none\" viewBox=\"0 0 1440 120\" preserveAspectRatio=\"none\">\n          <path d=\"M0,64L80,74.7C160,85,320,107,480,101.3C640,96,800,64,960,64C1120,64,1280,96,1360,112L1440,128L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z\"></path>\n        </svg>\n\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10\">\n          <p className=\"text-brand-teal font-bold tracking-widest text-sm uppercase mb-4\">The RIVO Difference</p>\n          <div className=\"grid lg:grid-cols-2 gap-16\">\n            <div>\n              <h2 className=\"font-serif text-4xl md:text-5xl lg:text-6xl mb-8 leading-tight\">Mortgage advice that starts with you \342\200\224 not the bank.</h2>\n              <p className=\"text-xl text-white/70 font-medium max-w-md\">We don\'t just find a rate. We look at the bigger picture.</p>\n            </div>\n            <div className=\"space-y-12\">\n              {[\n                { title: \"Understand\", desc: \"We learn about your goals.\" },\n                { title: \"Compare\", desc: \"We compare suitable lenders.\" },\n                { title: \"Structure\", desc: \"We help structure the right loan.\" },\n                { title: \"Support\", desc: \"We\'re with you through settlement.\" }\n              ].map((step, i) => (\n                <div key={i} className=\"flex gap-8 items-start\">\n                  <div className=\"font-serif text-5xl md:text-6xl text-brand-teal opacity-80 leading-none\">0{i+1}</div>\n                  <div className=\"pt-2\">\n                    <h4 className=\"font-bold text-2xl mb-2\">{step.title}</h4>\n                    <p className=\"text-white/60 text-lg\">{step.desc}</p>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        <svg className=\"absolute bottom-0 w-full text-brand-warm fill-current translate-y-[99%] pointer-events-none\" viewBox=\"0 0 1440 120\" preserveAspectRatio=\"none\">\n           <path d=\"M0,0L80,10.7C160,21,320,43,480,48C640,53,800,43,960,26.7C1120,11,1280,-11,1360,-21.3L1440,-32L1440,0L1360,0C1280,0,1120,0,960,0C800,0,640,0,480,0C320,0,160,0,80,0L0,0Z\"></path>\n        </svg>\n      </section>\n\n      {/* 5. Interactive Mortgage Calculator */}\n      <section className=\"py-40 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"text-center mb-16\">\n          <h2 className=\"font-serif text-4xl md:text-5xl text-brand-navy mb-4\">How much could you borrow?</h2>\n          <p className=\"text-lg text-brand-text-muted\">A quick estimate based on generic rates to get you started.</p>\n        </div>\n\n        <div className=\"bg-white p-8 md:p-16 rounded-[2.5rem] shadow-[0_20px_50px_rgba(23,53,82,0.06)] max-w-4xl mx-auto border border-slate-100\">\n          <div className=\"mb-12\">\n            <div className=\"flex justify-between items-end mb-4\">\n              <label className=\"font-bold text-brand-text-muted\">How much are you looking to borrow?</label>\n              <span className=\"text-3xl font-serif text-brand-navy\">{formatCurrency(propertyValue)}</span>\n            </div>\n            <input \n              type=\"range\" min=\"100000\" max=\"2500000\" step=\"10000\" \n              value={propertyValue} onChange={(e) => setPropertyValue(Number(e.target.value))}\n            />\n          </div>\n\n          <div className=\"mb-12\">\n            <div className=\"flex justify-between items-end mb-4\">\n              <label className=\"font-bold text-brand-text-muted\">Your deposit</label>\n              <span className=\"text-3xl font-serif text-brand-navy\">{formatCurrency(deposit)}</span>\n            </div>\n            <input \n              type=\"range\" min=\"0\" max={propertyValue} step=\"5000\" \n              value={deposit} onChange={(e) => setDeposit(Number(e.target.value))}\n            />\n          </div>\n\n          <div className=\"grid md:grid-cols-2 gap-6 mb-12\">\n            <div className=\"bg-brand-soft-teal p-8 rounded-3xl text-center\">\n              <p className=\"text-sm font-bold uppercase tracking-widest text-brand-teal mb-3\">Estimated Repayment</p>\n              <p className=\"text-4xl font-serif text-brand-navy\">{formatCurrency(monthlyRepayment)} <span className=\"text-base font-sans font-medium text-brand-text-muted\">/ month</span></p>\n            </div>\n            <div className=\"bg-slate-50 p-8 rounded-3xl text-center border border-slate-100\">\n              <p className=\"text-sm font-bold uppercase tracking-widest text-brand-text-muted mb-3\">Loan-to-value ratio</p>\n              <p className=\"text-4xl font-serif text-brand-navy\">{lvr}%</p>\n            </div>\n          </div>\n\n          <div className=\"text-center\">\n            <Link href=\"/contact\" className=\"inline-flex items-center justify-center px-10 py-5 bg-brand-navy text-white font-bold rounded-full hover:bg-brand-teal transition-colors shadow-lg\">\n              Talk to a Broker \342\206\222\n            </Link>\n          </div>\n        </div>\n      </section>\n\n      {/* 6. Your Journey Timeline */}\n      <section className=\"py-24 bg-white border-t border-slate-100\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center\">\n          <h2 className=\"font-serif text-4xl md:text-5xl text-brand-navy mb-20\">From \"What can I afford?\" to \"Welcome home.\"</h2>\n          \n          <div className=\"flex flex-col md:flex-row justify-between relative max-w-5xl mx-auto\">\n            <div className=\"absolute top-6 left-0 w-full h-0.5 bg-slate-100 hidden md:block\"></div>\n            {journeySteps.map((step, i) => (\n              <div key={i} className=\"relative z-10 flex flex-col items-center text-center max-w-[220px] mx-auto mb-12 md:mb-0 group\">\n                <div className=\"w-12 h-12 rounded-full bg-white border-[3px] border-slate-200 flex items-center justify-center font-bold text-brand-text-muted mb-6 transition-colors group-hover:border-brand-teal group-hover:text-brand-teal\">\n                  0{i+1}\n                </div>\n                <h4 className=\"font-bold text-brand-navy mb-3 tracking-widest text-sm uppercase\">{step.title}</h4>\n                <p className=\"text-sm font-medium text-brand-text-muted leading-relaxed\">{step.desc}</p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* 7. Human Broker Section */}\n      <section className=\"py-32 bg-brand-warm relative overflow-hidden\">\n        {/* Subtle Wave Graphic */}\n        <div className=\"absolute top-1/2 left-0 w-full -translate-y-1/2 opacity-5 pointer-events-none\">\n          <svg viewBox=\"0 0 1440 320\" className=\"w-full h-auto text-brand-navy fill-current\">\n            <path d=\"M0,128L60,149.3C120,171,240,213,360,202.7C480,192,600,128,720,117.3C840,107,960,149,1080,165.3C1200,181,1320,171,1380,165.3L1440,160L1440,320L1380,320C1320,320,1200,320,1080,320C960,320,840,320,720,320C600,320,480,320,360,320C240,320,120,320,60,320L0,320Z\"></path>\n          </svg>\n        </div>\n\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"grid md:grid-cols-2 gap-16 items-center\">\n            <div className=\"order-2 md:order-1 relative h-[600px] rounded-[3rem] overflow-hidden shadow-2xl\">\n              <Image \n                src=\"https://picsum.photos/id/1027/800/1200\" // A good portrait placeholder\n                alt=\"Rivo Lending Broker\"\n                fill\n                className=\"object-cover\"\n              />\n            </div>\n            <div className=\"order-1 md:order-2\">\n              <p className=\"text-brand-teal font-bold tracking-widest text-sm uppercase mb-4\">Meet Your Broker</p>\n              <h2 className=\"font-serif text-5xl lg:text-6xl text-brand-navy mb-8 leading-tight\">\n                Real people.<br/>Real advice.<br/>Real support.\n              </h2>\n              <p className=\"text-xl text-brand-text-muted font-medium mb-10 leading-relaxed max-w-md\">\n                You won\'t be passed from department to department. You\'ll have someone who knows your situation and is in your corner.\n              </p>\n              <Link href=\"/about\" className=\"inline-flex items-center font-bold text-brand-navy hover:text-brand-teal transition-colors\">\n                Meet the RIVO Team <ArrowRight className=\"w-5 h-5 ml-2\" />\n              </Link>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* 8. Success Stories */}\n      <section className=\"py-32 bg-white\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <h2 className=\"font-serif text-4xl md:text-5xl text-brand-navy mb-16 text-center\">Real people. Real property journeys.</h2>\n          \n          <div className=\"grid md:grid-cols-3 gap-8\">\n            {[\n              { title: \"FIRST HOME\", detail1: \"$620k property\", detail2: \"$95k deposit\", detail3: \"Loan approved\" },\n              { title: \"REFINANCE\", detail1: \"Saved $450 / month\", detail2: \"Debt consolidated\", detail3: \"Loan restructured\" },\n              { title: \"INVESTMENT\", detail1: \"Investment property\", detail2: \"$550k loan\", detail3: \"Portfolio strategy\" },\n            ].map((story, i) => (\n              <div key={i} className=\"p-10 rounded-3xl border border-slate-100 bg-brand-warm hover:bg-brand-soft-teal transition-colors group cursor-pointer\">\n                <p className=\"text-sm font-bold tracking-widest uppercase text-brand-navy mb-8\">{story.title}</p>\n                <div className=\"space-y-3 mb-12\">\n                  <p className=\"text-lg font-serif text-brand-text-muted\">{story.detail1}</p>\n                  <p className=\"text-lg font-serif text-brand-text-muted\">{story.detail2}</p>\n                  <p className=\"text-lg font-serif text-brand-navy font-bold\">{story.detail3}</p>\n                </div>\n                <p className=\"font-bold text-brand-teal flex items-center gap-2\">\n                  View story <ArrowRight className=\"w-4 h-4 transition-transform group-hover:translate-x-1\" />\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* 9. Social Proof (Large Testimonial) */}\n      <section className=\"py-32 bg-brand-soft-teal text-center px-4\">\n        <div className=\"max-w-4xl mx-auto\">\n          <p className=\"text-brand-teal font-bold tracking-widest text-sm uppercase mb-12\">Client Story</p>\n          <div className=\"flex justify-center gap-2 mb-8\">\n            {[1,2,3,4,5].map(s => <Star key={s} className=\"w-6 h-6 fill-brand-navy text-brand-navy\" />)}\n          </div>\n          <p className=\"font-serif text-3xl md:text-5xl text-brand-navy leading-snug mb-12\">\n            \"RIVO made what felt like a complicated process incredibly simple. We always knew what was happening and felt supported from our first conversation through to settlement.\"\n          </p>\n          <p className=\"font-bold text-brand-navy text-lg\">\342\200\224 Sarah & James</p>\n          <p className=\"text-brand-text-muted font-medium\">First Home Buyers</p>\n        </div>\n      </section>\n\n      {/* 10. Lender Network */}\n      <section className=\"py-32 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center\">\n        <p className=\"text-brand-teal font-bold tracking-widest text-sm uppercase mb-4\">We look beyond the big four</p>\n        <h2 className=\"font-serif text-4xl md:text-5xl text-brand-navy mb-8\">One conversation.<br/>Multiple lending options.</h2>\n        <p className=\"text-xl text-brand-text-muted font-medium mb-20 max-w-2xl mx-auto\">We help you understand the options \342\200\224 not just the interest rate.</p>\n        \n        {/* Abstract network diagram */}\n        <div className=\"relative max-w-3xl mx-auto py-12 flex items-center justify-center\">\n           {/* Center Node */}\n           <div className=\"w-24 h-24 bg-brand-teal text-white rounded-full flex items-center justify-center font-serif text-xl font-bold z-10 shadow-lg relative\">\n              RIVO\n           </div>\n           \n           {/* Connecting Lines (CSS absolute) */}\n           <div className=\"absolute top-1/2 left-[20%] right-[20%] h-px bg-slate-200 -z-10\"></div>\n           <div className=\"absolute top-[20%] bottom-[20%] left-1/2 w-px bg-slate-200 -z-10\"></div>\n           \n           {/* Satellite Nodes */}\n           <div className=\"absolute top-0 left-1/4 w-32 p-4 bg-white border border-slate-100 rounded-xl shadow-sm font-bold text-brand-text-muted text-sm\">Lender A</div>\n           <div className=\"absolute bottom-0 right-1/4 w-32 p-4 bg-white border border-slate-100 rounded-xl shadow-sm font-bold text-brand-text-muted text-sm\">Lender B</div>\n           <div className=\"absolute top-1/2 -translate-y-1/2 left-0 w-32 p-4 bg-white border border-slate-100 rounded-xl shadow-sm font-bold text-brand-text-muted text-sm\">Lender C</div>\n           <div className=\"absolute top-1/2 -translate-y-1/2 right-0 w-32 p-4 bg-white border border-slate-100 rounded-xl shadow-sm font-bold text-brand-text-muted text-sm\">Lender D</div>\n        </div>\n      </section>\n\n      {/* 11. FAQ */}\n      <section className=\"py-32 bg-white\">\n        <div className=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <h2 className=\"font-serif text-4xl text-brand-navy mb-16 text-center\">Frequently asked questions</h2>\n          \n          <div className=\"space-y-6\">\n            {faqs.map((faq, idx) => (\n              <div key={idx} className=\"border-b border-slate-100 pb-6\">\n                <button \n                  onClick={() => setOpenFaq(openFaq === idx ? null : idx)}\n                  className=\"w-full flex items-center justify-between text-left focus:outline-none group\"\n                >\n                  <span className=\"font-bold text-xl text-brand-navy pr-8 py-4 group-hover:text-brand-teal transition-colors\">{faq.q}</span>\n                  {openFaq === idx ? (\n                    <Minus className=\"w-6 h-6 text-brand-teal flex-shrink-0\" />\n                  ) : (\n                    <Plus className=\"w-6 h-6 text-brand-teal flex-shrink-0\" />\n                  )}\n                </button>\n                {openFaq === idx && (\n                  <motion.div \n                    initial={{ opacity: 0, height: 0 }} animate={{ opacity: 1, height: \'auto\' }}\n                    className=\"pr-12 text-brand-text-muted font-medium leading-relaxed pb-4\"\n                  >\n                    {faq.a}\n                  </motion.div>\n                )}\n              </div>\n            ))}\n          </div>\n        </div>\n      </section>\n\n      {/* 12. Final CTA */}\n      <section className=\"bg-gradient-to-br from-brand-teal to-brand-navy py-32 text-center text-white relative overflow-hidden\">\n        {/* Subtle Wave */}\n        <div className=\"absolute bottom-0 w-full opacity-10 pointer-events-none translate-y-1/2\">\n           <svg viewBox=\"0 0 1440 320\" className=\"w-full h-auto fill-white\">\n             <path d=\"M0,160L48,176C96,192,192,224,288,213.3C384,203,480,149,576,149.3C672,149,768,203,864,224C960,245,1056,235,1152,202.7C1248,171,1344,117,1392,90.7L1440,64L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z\"></path>\n           </svg>\n        </div>\n\n        <div className=\"relative z-10 px-4\">\n          <p className=\"font-bold tracking-widest text-sm uppercase mb-8 text-white/80\">Ready to make your next move?</p>\n          <h2 className=\"font-serif text-5xl md:text-6xl lg:text-7xl mb-8 max-w-4xl mx-auto leading-tight\">\n            Let\'s find a loan that works for where you are \342\200\224 and where you\'re going.\n          </h2>\n          \n          <Link href=\"/contact\" className=\"inline-flex mt-8 items-center justify-center px-10 py-5 bg-white text-brand-navy text-lg font-bold rounded-full hover:bg-brand-soft-teal transition-all shadow-[0_8px_30px_rgb(255,255,255,0.12)] hover:shadow-[0_8px_30px_rgb(255,255,255,0.25)] hover:-translate-y-1\">\n            Get Started \342\206\222\n          </Link>\n          \n          <p className=\"mt-16 text-white/70 font-medium\">Prefer to talk? <br/><span className=\"text-3xl font-serif text-white mt-4 block\">\342\230\216 1300 XXX XXX</span></p>\n        </div>\n      </section>\n\n      {/* Floating Contact Widget */}\n      <motion.div \n        initial={{ opacity: 0, y: 50 }} animate={{ opacity: 1, y: 0 }} transition={{ delay: 1 }}\n        className=\"fixed bottom-6 right-6 md:bottom-10 md:right-10 z-50\"\n      >\n        <Link href=\"/contact\" className=\"block bg-white rounded-2xl shadow-[0_20px_50px_rgba(23,53,82,0.15)] border border-slate-100 p-5 pr-14 relative cursor-pointer hover:shadow-[0_20px_50px_rgba(8,178,176,0.2)] transition-all group hover:-translate-y-1\">\n          <p className=\"font-bold text-brand-navy text-sm\">\360\237\221\213 Need some help?</p>\n          <p className=\"text-brand-teal font-bold text-sm mt-1\">Talk to a broker \342\206\222</p>\n          <div className=\"absolute top-1/2 -translate-y-1/2 right-5 w-3 h-3 bg-brand-teal rounded-full shadow-[0_0_0_4px_rgba(8,178,176,0.2)] animate-pulse\"></div>\n        </Link>\n      </motion.div>\n\n    </div>\n  );\n}\n"
    }
