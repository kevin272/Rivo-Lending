    replacement_chunks {
      target_content: "              <h2 className=\"font-serif text-4xl md:text-5xl lg:text-6xl mb-8 leading-tight\">Mortgage advice that starts with you.</h2>\n              <p className=\"text-xl text-white/70 font-medium mb-12 max-w-md leading-relaxed\">\n                We don\'t just find a rate. We look at the bigger picture. You won\'t be passed from department to department. You\'ll have a dedicated expert in your corner.\n              </p>"
      replacement_content: "              <h2 className=\"font-serif text-4xl md:text-5xl lg:text-6xl mb-8 leading-tight\">Mortgage advice that starts with you.</h2>\n              <p className=\"text-xl text-white/70 font-medium mb-12 max-w-md leading-relaxed\">\n                We specialize in helping Australian families, professionals, and investors structure loans that build long-term wealth. You won\'t be passed from department to department\342\200\224you\'ll have a dedicated expert in your corner.\n              </p>"
    }
    replacement_chunks {
      target_content: "      {/* =========================================\n          5. RESOURCES / CALCULATOR (Quiet Content)\n          ========================================= */}\n      <section id=\"resources\" className=\"py-24 bg-brand-warm border-t border-brand-navy/5\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n          <div className=\"text-center mb-12\">\n            <h2 className=\"font-serif text-3xl md:text-4xl text-brand-navy mb-4\">How much could you borrow?</h2>\n            <p className=\"text-base text-brand-text-muted\">A quick estimate based on generic rates to get you started.</p>\n          </div>\n\n          <div className=\"bg-white p-8 md:p-12 rounded-[2rem] max-w-4xl mx-auto border border-slate-100 shadow-sm\">\n            <div className=\"mb-10\">\n              <div className=\"flex justify-between items-end mb-4\">\n                <label className=\"font-bold text-sm text-brand-text-muted uppercase tracking-widest\">Property Value</label>\n                <span className=\"text-2xl font-serif text-brand-navy\">{formatCurrency(propertyValue)}</span>\n              </div>\n              <input \n                type=\"range\" min=\"100000\" max=\"2500000\" step=\"10000\" \n                value={propertyValue} onChange={(e) => setPropertyValue(Number(e.target.value))}\n              />\n            </div>\n\n            <div className=\"mb-12\">\n              <div className=\"flex justify-between items-end mb-4\">\n                <label className=\"font-bold text-sm text-brand-text-muted uppercase tracking-widest\">Your deposit</label>\n                <span className=\"text-2xl font-serif text-brand-navy\">{formatCurrency(deposit)}</span>\n              </div>\n              <input \n                type=\"range\" min=\"0\" max={propertyValue} step=\"5000\" \n                value={deposit} onChange={(e) => setDeposit(Number(e.target.value))}\n              />\n            </div>\n\n            <div className=\"grid md:grid-cols-2 gap-6 mb-8\">\n              <div className=\"bg-brand-soft-teal p-6 rounded-2xl text-center\">\n                <p className=\"text-xs font-bold uppercase tracking-widest text-brand-teal mb-2\">Estimated Repayment</p>\n                <p className=\"text-3xl font-serif text-brand-navy\">{formatCurrency(monthlyRepayment)} <span className=\"text-sm font-sans font-medium text-brand-text-muted\">/ month</span></p>\n              </div>\n              <div className=\"bg-slate-50 p-6 rounded-2xl text-center border border-slate-100\">\n                <p className=\"text-xs font-bold uppercase tracking-widest text-brand-text-muted mb-2\">Loan-to-value ratio</p>\n                <p className=\"text-3xl font-serif text-brand-navy\">{lvr}%</p>\n              </div>\n            </div>\n\n            {/* Contextual CTA Rhythm: Subtle link */}\n            <div className=\"text-center\">\n              <Link href=\"/contact\" className=\"inline-flex items-center text-sm font-bold text-brand-navy hover:text-brand-teal transition-colors\">\n                Discuss these numbers with a broker <ArrowRight className=\"w-4 h-4 ml-2\" />\n              </Link>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* =========================================\n          6. SOCIAL PROOF & FAQ (Quiet Texture)\n          ========================================= */}"
      replacement_content: "      {/* =========================================\n          5. SOCIAL PROOF & FAQ (Quiet Texture)\n          ========================================= */}"
